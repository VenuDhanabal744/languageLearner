    ], "drills": [
      { "id": "md1", "prompt": "Say: I need to study today.", "answer": "אֲנִי צָרִיךְ לִלְמֹד הַיּוֹם.", "tr": "aní tsaríkh lilmód ha-yóm." },
      { "id": "md2", "prompt": "Say: I can't come today.", "answer": "אֲנִי לֹא יָכוֹל לָבוֹא הַיּוֹם.", "tr": "aní lo yakhól lavó ha-yóm." },
      { "id": "md3", "prompt": "Ask politely: Could I have a coffee, please?", "answer": "אֶפְשָׁר קָפֶה, בְּבַקָּשָׁה?", "tr": "efshár kafé, bevakashá?" },
      { "id": "md4", "prompt": "Say: I want to go home.", "answer": "אֲנִי רוֹצֶה לָלֶכֶת הַבַּיְתָה.", "tr": "aní rotsé lalékhet ha-báyta." }
