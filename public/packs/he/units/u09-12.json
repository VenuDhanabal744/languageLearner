  "texts": [
    { "id": "d09", "title": "At the clinic", "level": "U9", "kind": "dialogue", "lines": [
      { "sp": "Doctor", "text": "שָׁלוֹם, מָה כּוֹאֵב לְךָ?", "tr": "shalóm, ma ko'év lekhá?", "en": "Hello, what hurts?" },
      { "sp": "You", "text": "כּוֹאֵב לִי הָרֹאשׁ, וְיֵשׁ לִי חֹם.", "tr": "ko'év li ha-rósh, ve-yésh li khom.", "en": "My head hurts, and I have a fever." },
      { "sp": "Doctor", "text": "מֵאָז מָתַי?", "tr": "me'áz matáy?", "en": "Since when?" },
      { "sp": "You", "text": "מֵאֶתְמוֹל. וַאֲנִי עָיֵף מְאוֹד.", "tr": "me-etmól. va-aní ayéf me'ód.", "en": "Since yesterday. And I'm very tired." },
      { "sp": "Doctor", "text": "כּוֹאֶבֶת לְךָ הַבֶּטֶן?", "tr": "ko'évet lekhá ha-béten?", "en": "Does your stomach hurt?" },
      { "sp": "You", "text": "לֹא, הַבֶּטֶן בְּסֵדֶר.", "tr": "lo, ha-béten be-séder.", "en": "No, my stomach is fine." },
      { "sp": "Doctor", "text": "לַחַץ הַדָּם בְּסֵדֶר, וְהַלֵּב בְּסֵדֶר. אַתָּה בָּרִיא.", "tr": "lákhats ha-dám be-séder, ve-ha-lév be-séder. atá barí.", "en": "Your blood pressure is fine, and your heart is fine. You're healthy." },
      { "sp": "Doctor", "text": "קַח אֶת הַתְּרוּפָה הַזֹּאת מִבֵּית הַמִּרְקַחַת.", "tr": "kakh et ha-trufá ha-zót mi-bét ha-mirkákhat.", "en": "Get this medicine from the pharmacy." },
      { "sp": "You", "text": "תּוֹדָה רַבָּה.", "tr": "todá rabá.", "en": "Thank you very much." },
      { "sp": "Doctor", "text": "רְפוּאָה שְׁלֵמָה!", "tr": "refu'á shlemá!", "en": "Get well soon!" }
    ], "verified": false },
    { "id": "d10", "title": "Taxi to the hotel", "level": "U10", "kind": "dialogue", "lines": [
      { "sp": "You", "text": "שָׁלוֹם, לַמָּלוֹן לְיַד הַיָּם, בְּבַקָּשָׁה.", "tr": "shalóm, la-malón le-yád ha-yám, bevakashá.", "en": "Hi, to the hotel by the sea, please." },
      { "sp": "Driver", "text": "בֶּטַח. זֶה לֹא רָחוֹק.", "tr": "bétakh. ze lo rakhók.", "en": "Sure. It's not far." },
      { "sp": "You", "text": "כַּמָּה זֶה עוֹלֶה?", "tr": "káma ze olé?", "en": "How much does it cost?" },
      { "sp": "Driver", "text": "לְפִי הַמּוֹנֶה.", "tr": "lefí ha-moné.", "en": "By the meter." },
      { "sp": "Driver", "text": "מֵאֵיפֹה אַתָּה? אַתָּה מְדַבֵּר עִבְרִית טוֹב!", "tr": "me-éfo atá? atá medabér ivrít tov!", "en": "Where are you from? You speak Hebrew well!" },
      { "sp": "You", "text": "מֵאָמֶרִיקָה. אֲנִי לוֹמֵד עִבְרִית בָּאוּנִיבֶרְסִיטָה.", "tr": "me-amérika. aní loméd ivrít ba-universíta.", "en": "From America. I'm learning Hebrew at the university." },
      { "sp": "Driver", "text": "הִגַּעְנוּ. הַמָּלוֹן מוּל הַיָּם, הַדֶּלֶת מִשְּׂמֹאל.", "tr": "higánu. ha-malón mul ha-yám, ha-délet mi-smól.", "en": "We're here. The hotel is opposite the sea, the door is on the left." },
      { "sp": "You", "text": "תּוֹדָה! לְהִתְרָאוֹת.", "tr": "todá! lehitra'ót.", "en": "Thanks! Bye." }
    ], "verified": false },
    { "id": "d11", "title": "Weekend plans", "level": "U11", "kind": "dialogue", "names": ["חיפה", "ירושלים", "ישראל"], "lines": [
      { "sp": "Noa", "text": "מָה אַתָּה עוֹשֶׂה בְּסוֹף הַשָּׁבוּעַ?", "tr": "ma atá osé be-sóf ha-shavú'a?", "en": "What are you doing this weekend?" },
      { "sp": "Venu", "text": "עוֹד לֹא יוֹדֵעַ. אוּלַי אֵלֵךְ לַשּׁוּק. לָמָּה?", "tr": "od lo yodé'a. uláy elékh la-shúk. láma?", "en": "Don't know yet. Maybe I'll go to the market. Why?" },
      { "sp": "Noa", "text": "אִם אַתָּה פָּנוּי בְּיוֹם שִׁשִּׁי, בּוֹא לְאֲרוּחַת שַׁבָּת!", "tr": "im atá panúy be-yóm shishí, bo le-arukhát shabát!", "en": "If you're free on Friday, come to Shabbat dinner!" },
      { "sp": "Venu", "text": "בֶּטַח! אֲבָל אֲנִי צָרִיךְ לִלְמֹד בַּבֹּקֶר. יֵשׁ לִי מִבְחָן.", "tr": "bétakh! avál aní tsaríkh lilmód ba-bóker. yesh li mivkhán.", "en": "Sure! But I need to study in the morning. I have an exam." },
      { "sp": "Noa", "text": "אֵין בְּעָיָה. אֶפְשָׁר לָבוֹא בָּעֶרֶב.", "tr": "en be'ayá. efshár lavó ba-érev.", "en": "No problem. You can come in the evening." },
      { "sp": "Venu", "text": "מְעֻלֶּה. וּבְעוֹד חֹדֶשׁ אֲנִי טָס לְיִשְׂרָאֵל!", "tr": "me'ulé. u-ve-ód khódesh aní tas le-yisra'él!", "en": "Great. And in a month I'm flying to Israel!" },
      { "sp": "Noa", "text": "וָואוּ! נְסִיעָה טוֹבָה!", "tr": "váu! nesi'á tová!", "en": "Wow! Have a good trip!" },
      { "sp": "Venu", "text": "תּוֹדָה! נִתְרָאֶה בְּשִׁשִּׁי, בְּעֶזְרַת הַשֵּׁם.", "tr": "todá! nitra'é be-shishí, be-ezrát ha-shém.", "en": "Thanks! See you Friday, God willing." }
    ], "verified": false },
    { "id": "m01", "title": "Reading: Jerusalem", "level": "U12", "kind": "reading", "names": ["ירושלים", "יפו", "תל", "אביב", "היסטוריה"], "lines": [
      { "text": "יְרוּשָׁלַיִם הִיא עִיר גְּדוֹלָה וְיָפָה.", "tr": "yerushaláyim hi ir gdolá ve-yafá.", "en": "Jerusalem is a big and beautiful city." },
      { "text": "זֹאת עִיר מְאוֹד יְשָׁנָה, עִם הַרְבֵּה הִיסְטוֹרְיָה.", "tr": "zot ir me'ód yeshaná, im harbé histórya.", "en": "It is a very old city, with a lot of history." },
      { "text": "בָּעִיר יֵשׁ שׁוּק גָּדוֹל, וְהַרְבֵּה אֲנָשִׁים קוֹנִים שָׁם פֵּרוֹת וִירָקוֹת.", "tr": "ba-ír yesh shuk gadól, ve-harbé anashím koním sham perót vi-yrakót.", "en": "In the city there's a big market, and many people buy fruit and vegetables there." },
      { "text": "אֲנָשִׁים מְדַבְּרִים שָׁם עִבְרִית, עֲרָבִית, אַנְגְּלִית, וְעוֹד הַרְבֵּה שָׂפוֹת.", "tr": "anashím medabrím sham ivrít, aravít, anglít, ve-ód harbé safót.", "en": "People there speak Hebrew, Arabic, English, and many more languages." },
      { "text": "בְּיוֹם שִׁשִּׁי בָּעֶרֶב מַתְחִילָה שַׁבָּת, וְהָעִיר שְׁקֵטָה.", "tr": "be-yóm shishí ba-érev matkhilá shabát, ve-ha-ír shketá.", "en": "On Friday evening Shabbat begins, and the city is quiet." }
    ], "verified": false },
    { "id": "b01", "title": "Genesis 1:1–5 (Biblical Hebrew)", "level": "U12", "kind": "authentic", "source": "Genesis 1:1–5, Masoretic text (public domain), with vowel points and without cantillation marks.", "lines": [
      { "text": "בְּרֵאשִׁית בָּרָא אֱלֹהִים אֵת הַשָּׁמַיִם וְאֵת הָאָרֶץ׃", "tr": "bereshít bará elohím et ha-shamáyim ve-ét ha-árets.", "en": "In the beginning God created the heavens and the earth." },
      { "text": "וְהָאָרֶץ הָיְתָה תֹהוּ וָבֹהוּ וְחֹשֶׁךְ עַל־פְּנֵי תְהוֹם וְרוּחַ אֱלֹהִים מְרַחֶפֶת עַל־פְּנֵי הַמָּיִם׃", "tr": "ve-ha-árets haytá tóhu va-vóhu ve-khóshekh al-pné tehóm ve-rú'akh elohím merakhéfet al-pné ha-máyim.", "en": "The earth was formless and empty, darkness was over the face of the deep, and the spirit of God hovered over the face of the waters." },
      { "text": "וַיֹּאמֶר אֱלֹהִים יְהִי אוֹר וַיְהִי־אוֹר׃", "tr": "va-yómer elohím yehí or va-yehí-or.", "en": "And God said, let there be light, and there was light." },
      { "text": "וַיַּרְא אֱלֹהִים אֶת־הָאוֹר כִּי־טוֹב וַיַּבְדֵּל אֱלֹהִים בֵּין הָאוֹר וּבֵין הַחֹשֶׁךְ׃", "tr": "va-yár elohím et-ha-ór ki-tóv va-yavdél elohím ben ha-ór u-vén ha-khóshekh.", "en": "And God saw the light, that it was good, and God separated the light from the darkness." },
      { "text": "וַיִּקְרָא אֱלֹהִים לָאוֹר יוֹם וְלַחֹשֶׁךְ קָרָא לָיְלָה וַיְהִי־עֶרֶב וַיְהִי־בֹקֶר יוֹם אֶחָד׃", "tr": "va-yikrá elohím la-ór yom ve-la-khóshekh kará láyla va-yehí-érev va-yehí-vóker yom ekhád.", "en": "God called the light Day, and the darkness he called Night. And there was evening and there was morning, one day." }
    ], "verified": false }
