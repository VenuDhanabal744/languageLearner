  "texts": [
    { "id": "d01", "title": "Meeting at Hillel", "level": "U1", "kind": "dialogue", "names": ["נועה", "ונו", "תל", "אביב", "אמריקה"], "lines": [
      { "sp": "Noa", "text": "שָׁלוֹם! מָה שְׁלוֹמְךָ?", "tr": "shalóm! ma shlomkhá?", "en": "Hi! How are you?" },
      { "sp": "Venu", "text": "שָׁלוֹם! אֲנִי בְּסֵדֶר, תּוֹדָה. וּמָה שְׁלוֹמֵךְ?", "tr": "shalóm! aní be-séder, todá. u-má shloméKH?", "en": "Hi! I'm fine, thanks. And how are you?" },
      { "sp": "Noa", "text": "טוֹב מְאוֹד. אֲנִי נוֹעָה. וּמִי אַתָּה?", "tr": "tov me'ód. aní Nóa. u-mí atá?", "en": "Very good. I'm Noa. And who are you?" },
      { "sp": "Venu", "text": "שְׁמִי וֵנוּ.", "tr": "shmi Venu.", "en": "My name is Venu." },
      { "sp": "Noa", "text": "מֵאֵיפֹה אַתָּה?", "tr": "me-éfo atá?", "en": "Where are you from?" },
      { "sp": "Venu", "text": "אֲנִי מֵאָמֶרִיקָה. וְאַתְּ?", "tr": "aní me-amérika. ve-át?", "en": "I'm from America. And you?" },
      { "sp": "Noa", "text": "אֲנִי מִתֵּל אָבִיב. נָעִים מְאוֹד!", "tr": "aní mi-tel avív. na'ím me'ód!", "en": "I'm from Tel Aviv. Nice to meet you!" },
      { "sp": "Venu", "text": "נָעִים מְאוֹד. לְהִתְרָאוֹת!", "tr": "na'ím me'ód. lehitra'ót!", "en": "Nice to meet you. See you!" }
    ], "verified": false },
    { "id": "d02", "title": "What do you study?", "level": "U2", "kind": "dialogue", "names": ["הופקינס"], "lines": [
      { "sp": "Noa", "text": "אַתָּה סְטוּדֶנְט פֹּה?", "tr": "atá studént po?", "en": "Are you a student here?" },
      { "sp": "Venu", "text": "כֵּן, אֲנִי סְטוּדֶנְט בְּהוֹפְּקִינְס.", "tr": "ken, aní studént be-hópkins.", "en": "Yes, I'm a student at Hopkins." },
      { "sp": "Noa", "text": "מָה אַתָּה לוֹמֵד?", "tr": "ma atá loméd?", "en": "What do you study?" },
      { "sp": "Venu", "text": "אֲנִי לוֹמֵד רְפוּאָה. וְגַם עִבְרִית וַעֲרָבִית!", "tr": "aní loméd refu'á. ve-gám ivrít va-aravít!", "en": "I study medicine. And Hebrew and Arabic too!" },
      { "sp": "Noa", "text": "אַתָּה מְדַבֵּר עִבְרִית?", "tr": "atá medabér ivrít?", "en": "Do you speak Hebrew?" },
      { "sp": "Venu", "text": "קְצָת. אֲנִי מְדַבֵּר אַנְגְּלִית וּסְפָרַדִּית.", "tr": "ktsat. aní medabér anglít u-sfaradít.", "en": "A little. I speak English and Spanish." },
      { "sp": "Noa", "text": "יָפֶה מְאוֹד! גַּם אֲנִי מְדַבֶּרֶת סְפָרַדִּית, אֲבָל קְצָת.", "tr": "yafé me'ód! gam aní medabéret sfaradít, avál ktsat.", "en": "Very nice! I speak Spanish too, but a little." }
    ], "verified": false },
    { "id": "d03", "title": "At a café in Tel Aviv", "level": "U3", "kind": "dialogue", "lines": [
      { "sp": "Barista", "text": "שָׁלוֹם! מָה אַתָּה רוֹצֶה?", "tr": "shalóm! ma atá rotsé?", "en": "Hi! What would you like?" },
      { "sp": "You", "text": "אֲנִי רוֹצֶה קָפֶה, בְּבַקָּשָׁה.", "tr": "aní rotsé kafé, bevakashá.", "en": "I'd like a coffee, please." },
      { "sp": "Barista", "text": "עִם חָלָב אוֹ בְּלִי?", "tr": "im khaláv o bli?", "en": "With milk or without?" },
      { "sp": "You", "text": "עִם חָלָב, בְּלִי סֻכָּר. יֵשׁ עוּגָה?", "tr": "im khaláv, bli sukár. yesh ugá?", "en": "With milk, no sugar. Is there cake?" },
      { "sp": "Barista", "text": "יֵשׁ. אַתָּה רָעֵב?", "tr": "yesh. atá ra'év?", "en": "There is. Are you hungry?" },
      { "sp": "You", "text": "כֵּן, מְאוֹד! כַּמָּה זֶה עוֹלֶה?", "tr": "ken, me'ód! káma ze olé?", "en": "Yes, very! How much is it?" },
      { "sp": "Barista", "text": "שְׁלוֹשִׁים שְׁקָלִים. בְּתֵאָבוֹן!", "tr": "shloshím shkalím. be-te'avón!", "en": "Thirty shekels. Enjoy!" },
      { "sp": "You", "text": "תּוֹדָה רַבָּה!", "tr": "todá rabá!", "en": "Thanks a lot!" }
    ], "verified": false },
    { "id": "d04", "title": "My day", "level": "U4", "kind": "reading", "names": ["ונו", "הופקינס"], "lines": [
      { "text": "אֲנִי וֵנוּ, סְטוּדֶנְט בְּהוֹפְּקִינְס.", "tr": "aní Venu, studént be-hópkins.", "en": "I'm Venu, a student at Hopkins." },
      { "text": "כָּל יוֹם אֲנִי הוֹלֵךְ לָאוּנִיבֶרְסִיטָה.", "tr": "kol yom aní holékh la-universíta.", "en": "Every day I go to the university." },
      { "text": "אֲנִי לוֹמֵד רְפוּאָה, וְגַם עִבְרִית.", "tr": "aní loméd refu'á, ve-gám ivrít.", "en": "I study medicine, and Hebrew too." },
      { "text": "אֲנִי אוֹהֵב עִבְרִית, אֲבָל לִפְעָמִים זֶה קָשֶׁה.", "tr": "aní ohév ivrít, avál lif'amím ze kashé.", "en": "I love Hebrew, but sometimes it's hard." },
      { "text": "אֲנִי שׁוֹתֶה הַרְבֵּה קָפֶה, כִּי יֵשׁ לִי הַרְבֵּה עֲבוֹדָה.", "tr": "aní shoté harbé kafé, ki yesh li harbé avodá.", "en": "I drink a lot of coffee, because I have a lot of work." },
      { "text": "עַכְשָׁיו אֲנִי לוֹמֵד. לְהִתְרָאוֹת!", "tr": "akhsháv aní loméd. lehitra'ót!", "en": "Right now I'm studying. See you!" }
    ], "verified": false }
  ]
}
