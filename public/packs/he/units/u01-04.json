    {"id": "sameakh", "text": "שָׂמֵחַ", "tr": "saméakh", "en": "happy, glad (f. smekhá)", "pos": "adj", "forms": ["שמח", "שמחה", "שמחים"], "ex": {"text": "אֲנִי שָׂמֵחַ מְאוֹד!", "tr": "aní saméakh me'ód!", "en": "I'm very happy!"}, "verified": false},
