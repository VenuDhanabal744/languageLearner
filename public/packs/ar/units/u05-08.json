  "texts": [
    { "id": "d05", "title": "In the library", "level": "U5", "v": "lev", "kind": "dialogue", "lines": [
      { "sp": "You", "text": "مَرحَبا، المَكتَبة مَفتوحة؟", "tr": "marḥaba, il-maktabe maftūḥa?", "en": "Hi, is the library open?" },
      { "sp": "Librarian", "text": "إي، مَفتوحة كِل يَوم. شو بِدَّك؟", "tr": "ʔē, maftūḥa kill yōm. shū biddak?", "en": "Yes, it's open every day. What do you need?" },
      { "sp": "You", "text": "بِدّي كْتاب عَرَبي لِلصَّفّ.", "tr": "biddi ktāb ʕarabi liṣ-ṣaff.", "en": "I need an Arabic book for class." },
      { "sp": "Librarian", "text": "في كْتير كُتُب هونيك. مين المُدَرِّس؟", "tr": "fī ktīr kutub hōnīk. mīn il-mudarris?", "en": "There are lots of books over there. Who's the teacher?" },
      { "sp": "You", "text": "المُدَرِّس سوري، وهُوِّ كاتِب كَمان.", "tr": "il-mudarris sūri, w huwwe kātib kamān.", "en": "The teacher is Syrian, and he's a writer too." },
      { "sp": "Librarian", "text": "عِندَك اِمتِحان؟", "tr": "ʕindak imtiḥān?", "en": "Do you have an exam?" },
      { "sp": "You", "text": "إي، بُكرا. عِندي سُؤال: وين المَكتَب؟", "tr": "ʔē, bukra. ʕindi suʔāl: wēn il-maktab?", "en": "Yes, tomorrow. I have a question: where's the office?" },
      { "sp": "Librarian", "text": "هونيك. يَلّا، بِالتَّوفيق!", "tr": "hōnīk. yalla, bit-tawfīʔ!", "en": "Over there. Good luck!" }
    ], "verified": false },
    { "id": "d06", "title": "What did you do yesterday?", "level": "U6", "v": "lev", "kind": "dialogue", "names": ["ليلى"], "lines": [
      { "sp": "Layla", "text": "شو عْمِلت مْبارِح؟", "tr": "shū ʕmilt mbāriḥ?", "en": "What did you do yesterday?" },
      { "sp": "Venu", "text": "الصُّبح رِحت عالجامْعة، وبَعدين رِحت عالمَكتَبة.", "tr": "iṣ-ṣubḥ riḥt ʕal-jāmʕa, w baʕdēn riḥt ʕal-maktabe.", "en": "In the morning I went to the university, and then I went to the library." },
      { "sp": "Layla", "text": "وشو أَكَلت؟", "tr": "w shū ʔakalt?", "en": "And what did you eat?" },
      { "sp": "Venu", "text": "أَكَلت خِبز وشْرِبت قَهوة. ما كان في وَقت.", "tr": "ʔakalt khibz w shribt ʔahwe. mā kān fī waʔt.", "en": "I ate bread and drank coffee. There was no time." },
      { "sp": "Layla", "text": "وبَعد الصَّفّ؟", "tr": "w baʕd iṣ-ṣaff?", "en": "And after class?" },
      { "sp": "Venu", "text": "حَكيت مَع إمّي، وبِالمَسا دَرَست شْوَي.", "tr": "ḥakēt maʕ immi, w bil-masa darast shwayy.", "en": "I talked with my mom, and in the evening I studied a bit." },
      { "sp": "Layla", "text": "وهَلَّق؟", "tr": "w hallaʔ?", "en": "And now?" },
      { "sp": "Venu", "text": "هَلَّق لِسّا عِندي شُغل. بَعدين بْنام!", "tr": "hallaʔ lissa ʕindi shughl. baʕdēn bnām!", "en": "Now I still have work. Then I'll sleep!" }
    ], "verified": false },
    { "id": "d07", "title": "My family", "level": "U7", "v": "lev", "kind": "reading", "names": ["لبنان"], "lines": [
      { "text": "عيلْتي مِش كْبيرة.", "tr": "ʕēlti mish kbīre.", "en": "My family isn't big." },
      { "text": "عِندي أَخ واحِد وأُخت وحدة.", "tr": "ʕindi ʔakh wāḥad w ʔukht waḥde.", "en": "I have one brother and one sister." },
      { "text": "أَخي طالِب كَمان، وهُوِّ مِتجَوِّز.", "tr": "ʔakhi ṭālib kamān, w huwwe mitjawwez.", "en": "My brother is a student too, and he's married." },
      { "text": "أُختي زْغيرة، بِتروح عالمَدرَسة.", "tr": "ʔukhti zghīre, btrūḥ ʕal-madrase.", "en": "My sister is young; she goes to school." },
      { "text": "إمّي حَكيمة، وبَيّي عِندو شُغل بِمَكتَب.", "tr": "immi ḥakīme, w bayyi ʕindo shughl b-maktab.", "en": "My mom is a doctor, and my dad works in an office." },
      { "text": "تيتا وجِدّو ساكنين بِلُبنان.", "tr": "tēta w jiddo sāknīn b-Libnān.", "en": "Grandma and grandpa live in Lebanon." },
      { "text": "بحِبّ عيلْتي كْتير.", "tr": "bḥibb ʕēlti ktīr.", "en": "I love my family a lot." }
    ], "verified": false },
    { "id": "d08", "title": "In the souk", "level": "U8", "v": "lev", "kind": "dialogue", "lines": [
      { "sp": "You", "text": "مَرحَبا، قَدّيش هادا؟", "tr": "marḥaba, ʔaddēsh hāda?", "en": "Hi, how much is this?" },
      { "sp": "Seller", "text": "هادا بْعَشرة.", "tr": "hāda b-ʕashara.", "en": "This one's ten." },
      { "sp": "You", "text": "عَشرة؟ غالي كْتير!", "tr": "ʕashara? ghāli ktīr!", "en": "Ten? That's very expensive!" },
      { "sp": "Seller", "text": "لأ، مِش غالي. هادا مْنيح كْتير.", "tr": "laʔ, mish ghāli. hāda mnīḥ ktīr.", "en": "No, it's not expensive. This is very good." },
      { "sp": "You", "text": "بِدّي تْنين. بْسَبعة الواحِد؟", "tr": "biddi tnēn. b-sabʕa il-wāḥad?", "en": "I want two. Seven each?" },
      { "sp": "Seller", "text": "لأ، بْتِسعة.", "tr": "laʔ, b-tisʕa.", "en": "No, nine." },
      { "sp": "You", "text": "طَيِّب، تْمانية؟", "tr": "ṭayyib, tmēne?", "en": "OK, eight?" },
      { "sp": "Seller", "text": "يَلّا، عادي. صَحتين!", "tr": "yalla, ʕādi. ṣaḥtēn!", "en": "Fine, OK. Enjoy!" },
      { "sp": "You", "text": "باخُد تْنين. شُكرًا!", "tr": "bākhud tnēn. shukran!", "en": "I'll take two. Thanks!" }
    ], "verified": false }
  ]
