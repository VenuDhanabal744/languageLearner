  "grammar": [
    { "id": "objects", "title": "Me, you, him: endings on verbs", "body": [
      "Object pronouns attach to verbs: **-ni** me · **-ak** you (m) · **-ik** you (f) · **-o** him · **-a** her · **-na** us · **-kon** you (pl) · **-hon** them.",
      "**byūjaʕni** = it hurts me · **shiftak** = I saw you · **bḥibbo** = I love him / it."
    ], "examples": [
      { "text": "راسي بيوجَعني.", "tr": "rāsi byūjaʕni.", "en": "My head hurts (me)." },
      { "text": "شِفتا مْبارِح.", "tr": "shifta mbāriḥ.", "en": "I saw her yesterday." }
    ], "drills": [
      { "id": "ob1", "prompt": "Say: My stomach hurts.", "answer": "بَطني بيوجَعني.", "tr": "baṭni byūjaʕni." },
      { "id": "ob2", "prompt": "Say: I saw him at the university.", "answer": "شِفتو بِالجامْعة.", "tr": "shifto bil-jāmʕa." },
      { "id": "ob3", "prompt": "Say: I love it (m).", "answer": "بحِبّو.", "tr": "bḥibbo." }
    ], "verified": false },
    { "id": "negation", "title": "mā vs mish", "body": [
      "**mā** negates verbs and the verb-like words fī, ʕind-, bidd-: mā baʕrif, mā fī, mā ʕindi, mā biddi.",
      "**mish** negates everything else: nouns, adjectives, participles, places: mish marīḍ, mish hōn, mish ṭālib. (In Beirut you'll also hear mish + b-verb.)"
    ], "examples": [
      { "text": "مِش مَريض، بَس تَعبان.", "tr": "mish marīḍ, bass taʕbān.", "en": "Not sick, just tired." },
      { "text": "ما عِندي حَرارة.", "tr": "mā ʕindi ḥarāra.", "en": "I don't have a fever." }
    ], "drills": [
      { "id": "ng1", "prompt": "Say: I'm not sick.", "answer": "أَنا مِش مَريض.", "tr": "ʔana mish marīḍ." },
      { "id": "ng2", "prompt": "Say: I don't have a fever.", "answer": "ما عِندي حَرارة.", "tr": "mā ʕindi ḥarāra." },
      { "id": "ng3", "prompt": "Say: The pharmacy isn't far.", "answer": "الصَّيدَلية مِش بْعيدة.", "tr": "iṣ-ṣaydaliyye mish bʕīde." },
      { "id": "ng4", "prompt": "Say: I don't understand.", "answer": "ما بِفهَم.", "tr": "mā bifham." }
    ], "verified": false },
    { "id": "prepositions", "title": "Prepositions of place", "body": [
      "**b-** in/at (bil-bēt) · **ʕa-** to/on (ʕal-jāmʕa) · **min** from · **maʕ** with · **ʕind** at someone's place (ʕind il-ḥakīm) · **janb** next to · **ʔiddām** in front of · **wara** behind · **fōʔ** above · **taḥt** under.",
      "b- and ʕa- join il-: **b + il-bēt → bil-bēt**, **ʕa + il-jāmʕa → ʕal-jāmʕa**."
    ], "examples": [
      { "text": "الصَّيدَلية جَنب المُستَشفى.", "tr": "iṣ-ṣaydaliyye janb il-mustashfa.", "en": "The pharmacy is next to the hospital." },
      { "text": "رِحت عالسّوق مَع صاحْبي.", "tr": "riḥt ʕas-sūʔ maʕ ṣāḥbi.", "en": "I went to the market with my friend." }
    ], "drills": [
      { "id": "pp1", "prompt": "Say: I'm at home.", "answer": "أَنا بِالبَيت.", "tr": "ʔana bil-bēt." },
      { "id": "pp2", "prompt": "Say: I go to the university.", "answer": "بْروح عالجامْعة.", "tr": "brūḥ ʕal-jāmʕa." },
      { "id": "pp3", "prompt": "Say: The key is under the book.", "answer": "المِفتاح تَحت الكْتاب.", "tr": "il-miftāḥ taḥt il-ktāb." },
      { "id": "pp4", "prompt": "Say: The hotel is next to the market.", "answer": "الأوتيل جَنب السّوق.", "tr": "il-ʔōtēl janb is-sūʔ." }
    ], "verified": false },
    { "id": "imperative", "title": "Commands", "body": [
      "Take the 'you' present form and drop **b-t-**: btrūḥ → **rūḥ!** go! · btiḥki → **ḥki!** speak! · btākhud → **khūd!** take!",
      "To a woman add **-i** (rūḥi, khidi), to a group **-u** (rūḥu). Don't…! = **lā** + t-form: lā trūḥ = don't go."
    ], "examples": [
      { "text": "روح دُغري، وبَعدين يَمين.", "tr": "rūḥ dighri, w baʕdēn yamīn.", "en": "Go straight, then right." },
      { "text": "خِدي الدَّوا.", "tr": "khidi id-dawa.", "en": "Take (f) the medicine." }
    ], "drills": [
      { "id": "im1", "prompt": "Tell a man: Go straight.", "answer": "روح دُغري.", "tr": "rūḥ dighri." },
      { "id": "im2", "prompt": "Tell a man: Take a taxi.", "answer": "خود تَكسي.", "tr": "khūd taksi." },
      { "id": "im3", "prompt": "Tell a woman: Speak Arabic!", "answer": "اِحكي عَرَبي!", "tr": "iḥki ʕarabi!" },
      { "id": "im4", "prompt": "Tell a man: Don't go!", "answer": "لا تْروح!", "tr": "lā trūḥ!" }
    ], "verified": false },
    { "id": "future", "title": "Future: raḥ + verb (no b-)", "body": [
      "Put **raḥ** before the verb and drop the b-: **raḥ rūḥ** I'll go · **raḥ trūḥ** you'll go · **raḥ yrūḥ** he'll go · **raḥ nrūḥ** we'll go.",
      "You'll also hear **ḥa-** in some areas. Negate with **mā raḥ**: mā raḥ rūḥ = I won't go."
    ], "examples": [
      { "text": "رَح إدرُس بِالمَكتَبة بُكرا.", "tr": "raḥ idrus bil-maktabe bukra.", "en": "I'll study in the library tomorrow." },
      { "text": "ما رَح إجي يَوم الجُمعة.", "tr": "mā raḥ ʔiji yōm il-jimʕa.", "en": "I won't come on Friday." }
    ], "drills": [
      { "id": "fu1", "prompt": "Say: I'll go tomorrow.", "answer": "رَح روح بُكرا.", "tr": "raḥ rūḥ bukra." },
      { "id": "fu2", "prompt": "Say: I won't come on Friday.", "answer": "ما رَح إجي يَوم الجُمعة.", "tr": "mā raḥ ʔiji yōm il-jimʕa." },
      { "id": "fu3", "prompt": "Ask a man: What will you do on Saturday?", "answer": "شو رَح تَعمِل يَوم السَّبت؟", "tr": "shū raḥ taʕmel yōm is-sabt?" }
    ], "verified": false },
    { "id": "modals", "title": "must / can / want + bare verb", "concept": "subjunctive", "body": [
      "After **lāzim** (must), **mumkin** (could), **biʔdar** (I can), **bidd-** (want), and **raḥ**, the verb has no b-: lāzim **rūḥ**, biddi **ʔiʕrif**, biʔdar **ʔiji**.",
      "The person prefix stays: lāzim **trūḥ** (you must go), lāzim **yrūḥ** (he must go)."
    ], "examples": [
      { "text": "لازِم إدرُس، عِندي اِمتِحان.", "tr": "lāzim idrus, ʕindi imtiḥān.", "en": "I have to study, I have an exam." },
      { "text": "مُمكِن تِحكي شْوَي شْوَي؟", "tr": "mumkin tiḥki shwayy shwayy?", "en": "Could you speak slowly?" }
    ], "drills": [
      { "id": "md1", "prompt": "Say: I have to study today.", "answer": "لازِم إدرُس اليوم.", "tr": "lāzim idrus il-yōm." },
      { "id": "md2", "prompt": "Ask a man politely: Could you speak slowly?", "answer": "مُمكِن تِحكي شْوَي شْوَي؟", "tr": "mumkin tiḥki shwayy shwayy?" },
      { "id": "md3", "prompt": "Say: I can't come today.", "answer": "ما بِقدَر إجي اليوم.", "tr": "mā biʔdar ʔiji il-yōm." },
      { "id": "md4", "prompt": "Say: I want to go to the airport.", "answer": "بِدّي روح عالمَطار.", "tr": "biddi rūḥ ʕal-maṭār." }
    ], "verified": false },
    { "id": "msa-map", "title": "Shami → MSA: the main swaps", "body": [
      "You already know most MSA words: roots and nouns are largely shared. The big differences are small function words:",
      "mish → **laysa** · mā (verb) → **lā / lam** · biddi → **ʔurīdu** · shū → **mādhā** · wēn → **ʔayna** · hallaʔ → **al-ʔāna** · ktīr → **jiddan / kathīr** · raḥ → **sawfa / sa-** · hāda / hāy → **hādhā / hādhihi** · illi → **alladhī** · niḥna → **naḥnu** · hinne → **hum**.",
      "Pronunciation: MSA says ق as q, ث as th, ذ as dh, and ج as j."
    ], "examples": [
      { "text": "أُريدُ أَن أَذهَبَ إِلى المَكتَبة.", "tr": "ʔurīdu ʔan ʔadhhaba ʔilā l-maktaba.", "en": "I want to go to the library. (Shami: biddi rūḥ ʕal-maktabe.)" }
    ], "drills": [
      { "id": "mm1", "prompt": "MSA for Shami 'mish ṣaʕb' (not hard):", "answer": "لَيسَ صَعبًا", "tr": "laysa ṣaʕban" },
      { "id": "mm2", "prompt": "MSA for Shami 'wēn' (where):", "answer": "أَينَ", "tr": "ʔayna" },
      { "id": "mm3", "prompt": "MSA for Shami 'hallaʔ' (now):", "answer": "الآن", "tr": "al-ʔāna" },
      { "id": "mm4", "prompt": "MSA for Shami 'biddi' (I want):", "answer": "أُريدُ", "tr": "ʔurīdu" },
      { "id": "mm5", "prompt": "MSA for Shami 'shū' (what, before a verb):", "answer": "ماذا", "tr": "mādhā" }
    ], "verified": false },
    { "id": "msa-verbs", "title": "MSA verbs: no b-, final -u", "concept": "aspect", "body": [
      "MSA present has no b-, and formal reading adds a final -u: **ʔaktubu** I write · **taktubu** you write · **yaktubu** he writes · **naktubu** we write. Compare Shami baktob, btiktob, byiktob, mniktob.",
      "Negation: **lā yaktubu** he doesn't write · **lam yaktub** he didn't write · **lan yaktuba** he won't write · future **sa-yaktubu / sawfa yaktubu**."
    ], "examples": [
      { "text": "يَدرُسُ الطّالِبُ الطِّبَّ.", "tr": "yadrusu ṭ-ṭālibu ṭ-ṭibba.", "en": "The student studies medicine." },
      { "text": "لَم يَذهَب إِلى الجامِعة.", "tr": "lam yadhhab ʔilā l-jāmiʕa.", "en": "He didn't go to the university." }
    ], "drills": [
      { "id": "mv1", "prompt": "MSA: He studies (d-r-s).", "answer": "يَدرُسُ", "tr": "yadrusu" },
      { "id": "mv2", "prompt": "MSA: He didn't go.", "answer": "لَم يَذهَب", "tr": "lam yadhhab" },
      { "id": "mv3", "prompt": "MSA: I will go (with sawfa).", "answer": "سَوفَ أَذهَبُ", "tr": "sawfa ʔadhhabu" }
    ], "verified": false }
  ],
  "texts": [
    { "id": "d09", "title": "At the clinic", "level": "U9", "v": "lev", "kind": "dialogue", "lines": [
      { "sp": "Doctor", "text": "أَهلا، شو بيوجَعَك؟", "tr": "ʔahlan, shū byūjaʕak?", "en": "Hello, what's hurting you?" },
      { "sp": "You", "text": "راسي بيوجَعني، وعِندي حَرارة.", "tr": "rāsi byūjaʕni, w ʕindi ḥarāra.", "en": "My head hurts, and I have a fever." },
      { "sp": "Doctor", "text": "مِن إيمتى؟", "tr": "min ʔēmta?", "en": "Since when?" },
      { "sp": "You", "text": "مِن مْبارِح. وأَنا تَعبان كْتير.", "tr": "min mbāriḥ. w ʔana taʕbān ktīr.", "en": "Since yesterday. And I'm very tired." },
      { "sp": "Doctor", "text": "بَطنَك بيوجَعَك؟", "tr": "baṭnak byūjaʕak?", "en": "Does your stomach hurt?" },
      { "sp": "You", "text": "لأ، بَطني مْنيح.", "tr": "laʔ, baṭni mnīḥ.", "en": "No, my stomach is fine." },
      { "sp": "Doctor", "text": "الضَّغط عادي، والقَلب مْنيح. خود نَفَس.", "tr": "iḍ-ḍaghṭ ʕādi, wil-ʔalb mnīḥ. khūd nafas.", "en": "Your blood pressure is normal and your heart is fine. Take a breath." },
      { "sp": "Doctor", "text": "مِش شي كْبير. خود هادا الدَّوا مِن الصَّيدَلية.", "tr": "mish shī kbīr. khūd hāda id-dawa min iṣ-ṣaydaliyye.", "en": "It's nothing serious. Get this medicine from the pharmacy." },
      { "sp": "You", "text": "شُكرًا كْتير.", "tr": "shukran ktīr.", "en": "Thank you very much." },
      { "sp": "Doctor", "text": "سَلامتَك!", "tr": "salāmtak!", "en": "Get well soon!" }
    ], "verified": false },
    { "id": "d10", "title": "Taxi to the market", "level": "U10", "v": "lev", "kind": "dialogue", "lines": [
      { "sp": "You", "text": "مَرحَبا، بِدّي روح عالسّوق، لَو سَمَحت.", "tr": "marḥaba, biddi rūḥ ʕas-sūʔ, law samaḥt.", "en": "Hi, I'd like to go to the market, please." },
      { "sp": "Driver", "text": "أَهلا! السّوق مِش بْعيد. يَلّا.", "tr": "ʔahlan! is-sūʔ mish bʕīd. yalla.", "en": "Hi! The market isn't far. Let's go." },
      { "sp": "You", "text": "قَدّيش؟", "tr": "ʔaddēsh?", "en": "How much?" },
      { "sp": "Driver", "text": "عَشرة.", "tr": "ʕashara.", "en": "Ten." },
      { "sp": "You", "text": "طَيِّب، ماشي.", "tr": "ṭayyib, māshi.", "en": "OK, fine." },
      { "sp": "Driver", "text": "إنتَ مْنين؟ بْتِحكي عَرَبي مْنيح!", "tr": "inta mnēn? btiḥki ʕarabi mnīḥ!", "en": "Where are you from? You speak Arabic well!" },
      { "sp": "You", "text": "مِن أَميركا. بَدرُس عَرَبي بِالجامْعة.", "tr": "min ʔamērka. badrus ʕarabi bil-jāmʕa.", "en": "From America. I study Arabic at the university." },
      { "sp": "Driver", "text": "هون السّوق. الباب قِدّامَك، ورا الجامِع.", "tr": "hōn is-sūʔ. il-bāb ʔiddāmak, wara l-jāmiʕ.", "en": "Here's the market. The gate is in front of you, behind the mosque." },
      { "sp": "You", "text": "شُكرًا! مَع السَّلامة.", "tr": "shukran! maʕ is-salāme.", "en": "Thanks! Goodbye." }
    ], "verified": false },
    { "id": "d11", "title": "Weekend plans", "level": "U11", "v": "lev", "kind": "dialogue", "names": ["بيروت"], "lines": [
      { "sp": "Rami", "text": "شو رَح تَعمِل يَوم الجُمعة؟", "tr": "shū raḥ taʕmel yōm il-jimʕa?", "en": "What are you doing on Friday?" },
      { "sp": "Venu", "text": "ما بَعرِف. يِمكِن روح عالسّوق. لَيش؟", "tr": "mā baʕrif. yimkin rūḥ ʕas-sūʔ. lēsh?", "en": "I don't know. Maybe I'll go to the market. Why?" },
      { "sp": "Rami", "text": "إذا فاضي، تَعا نِشرَب قَهوة.", "tr": "ʔiza fāḍi, taʕa nishrab ʔahwe.", "en": "If you're free, come have a coffee." },
      { "sp": "Venu", "text": "أَكيد! بَس لازِم إدرُس الصُّبح. عِندي اِمتِحان يَوم الأَحَد.", "tr": "ʔakīd! bass lāzim idrus iṣ-ṣubḥ. ʕindi imtiḥān yōm il-ʔaḥad.", "en": "Definitely! But I have to study in the morning. I have an exam on Sunday." },
      { "sp": "Rami", "text": "ماشي، بَعد الضُّهر؟", "tr": "māshi, baʕd iḍ-ḍuhr?", "en": "OK, in the afternoon?" },
      { "sp": "Venu", "text": "طَبعًا. وبَعد شَهر رَح سافِر عَلى بيروت!", "tr": "ṭabʕan. w baʕd shahr raḥ sāfir ʕala Bēirūt!", "en": "Of course. And in a month I'm travelling to Beirut!" },
      { "sp": "Rami", "text": "يا سَلام! رَح تِحكي عَرَبي كْتير هونيك.", "tr": "yā salām! raḥ tiḥki ʕarabi ktīr hōnīk.", "en": "Wow! You'll speak a lot of Arabic there." },
      { "sp": "Venu", "text": "إن شاء الله! يَلّا، بْشوفَك الجُمعة.", "tr": "inshalla! yalla, bshūfak il-jimʕa.", "en": "Hopefully! OK, see you Friday." }
    ], "verified": false },
    { "id": "m01", "title": "MSA reading: Damascus", "level": "U12", "v": "msa", "kind": "reading", "names": ["دمشق", "سوريا"], "lines": [
      { "text": "دِمَشقُ عاصِمةُ سوريا.", "tr": "dimashqu ʕāṣimatu sūriyā.", "en": "Damascus is the capital of Syria." },
      { "text": "هِيَ مَدينة قَديمة جِدًّا وجَميلة.", "tr": "hiya madīna qadīma jiddan wa-jamīla.", "en": "It is a very old and beautiful city." },
      { "text": "في المَدينة سوق كَبير ومَطاعِم كَثيرة.", "tr": "fī l-madīna sūq kabīr wa-maṭāʕim kathīra.", "en": "In the city there is a big market and many restaurants." },
      { "text": "سُكّانُ دِمَشقَ يَتَكَلَّمونَ العَرَبيّة الشّاميّة.", "tr": "sukkānu dimashqa yatakallamūna l-ʕarabiyya sh-shāmiyya.", "en": "The people of Damascus speak Shami Arabic." },
      { "text": "ولٰكِنَّهُم يَقرَؤونَ الأَخبارَ بِالفُصحى.", "tr": "wa-lākinnahum yaqraʔūna l-ʔakhbāra bil-fuṣḥā.", "en": "But they read the news in MSA (fuṣḥā)." }
    ], "verified": false },
    { "id": "m02", "title": "MSA reading: A student's day", "level": "U12", "v": "msa", "kind": "reading", "names": ["ليلى"], "lines": [
      { "text": "لَيلى طالِبة في الجامِعة.", "tr": "laylā ṭāliba fī l-jāmiʕa.", "en": "Layla is a student at the university." },
      { "text": "هِيَ تَدرُسُ الطِّبَّ.", "tr": "hiya tadrusu ṭ-ṭibba.", "en": "She studies medicine." },
      { "text": "كُلَّ يَوم تَذهَبُ إِلى المَكتَبة.", "tr": "kulla yawm tadhhabu ʔilā l-maktaba.", "en": "Every day she goes to the library." },
      { "text": "أَمسِ لَم تَذهَب، لِأَنَّها كانَت مَريضة.", "tr": "ʔamsi lam tadhhab, liʔannahā kānat marīḍa.", "en": "Yesterday she didn't go, because she was sick." },
      { "text": "سَوفَ تَذهَبُ غَدًا، إن شاء الله.", "tr": "sawfa tadhhabu ghadan, in shāʔa llāh.", "en": "She will go tomorrow, God willing." }
    ], "verified": false },
    { "id": "m03", "title": "MSA reading: The Arabic language", "level": "U12", "v": "msa", "kind": "reading", "lines": [
      { "text": "العَرَبيّة لُغة كَبيرة في العالَم.", "tr": "al-ʕarabiyya lugha kabīra fī l-ʕālam.", "en": "Arabic is a big language in the world." },
      { "text": "لِلعَرَبيّة تاريخ قَديم.", "tr": "lil-ʕarabiyya tārīkh qadīm.", "en": "Arabic has an ancient history." },
      { "text": "النّاسُ يَتَكَلَّمونَ لَهَجات كَثيرة، مِثلَ الشّاميّة والمِصريّة.", "tr": "an-nāsu yatakallamūna lahajāt kathīra, mithla sh-shāmiyya wal-miṣriyya.", "en": "People speak many dialects, like Shami and Egyptian." },
      { "text": "ولٰكِنَّ الكُتُبَ والأَخبارَ بِالفُصحى.", "tr": "wa-lākinna l-kutuba wal-ʔakhbāra bil-fuṣḥā.", "en": "But books and news are in MSA." },
      { "text": "الطّالِبُ الَّذي يَعرِفُ الاِثنَتَينِ يَفهَمُ كُلَّ شَيء.", "tr": "aṭ-ṭālibu lladhī yaʕrifu l-ithnatayni yafhamu kulla shayʔ.", "en": "The student who knows both understands everything." }
    ], "verified": false }
  ]
}
