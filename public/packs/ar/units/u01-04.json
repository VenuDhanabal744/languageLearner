  "grammar": [
    { "id": "pronouns", "title": "Personal pronouns", "body": [
      "Levantine pronouns: **ʔana** I · **inta** you (m) · **inti** you (f) · **huwwe** he · **hiyye** she · **niḥna** we · **intu** you (pl) · **hinne** they.",
      "Arabic always distinguishes 'you' to a man vs a woman, so verbs and adjectives change too (kīfak / kīfik)."
    ], "examples": [
      { "text": "أَنا فينو، وإنتِ؟", "tr": "ʔana Venu, w inti?", "en": "I'm Venu, and you (f)?" },
      { "text": "نِحنا طُلّاب.", "tr": "niḥna ṭullāb.", "en": "We're students." },
      { "text": "هِنّي مِن لُبنان.", "tr": "hinne min Libnān.", "en": "They're from Lebanon." }
    ], "drills": [
      { "id": "pr1", "prompt": "Say: I'm Venu.", "answer": "أَنا فينو.", "tr": "ʔana Venu." },
      { "id": "pr2", "prompt": "Ask a woman: and you?", "answer": "وإنتِ؟", "tr": "w inti?" },
      { "id": "pr3", "prompt": "Say: He's from Lebanon.", "answer": "هُوِّ مِن لُبنان.", "tr": "huwwe min Libnān." },
      { "id": "pr4", "prompt": "Say: We're from America.", "answer": "نِحنا مِن أَميركا.", "tr": "niḥna min ʔamērka." }
    ], "verified": false },
    { "id": "nocopula", "title": "No 'is/are' in the present", "concept": "copula-zero", "body": [
      "Arabic doesn't say 'am / is / are' in the present. Just put the two parts side by side: **ʔana mnīḥ** = I (am) fine; **huwwe min Libnān** = he (is) from Lebanon.",
      "You'll meet the past 'was' (kān) in Unit 6."
    ], "examples": [
      { "text": "أَنا مْنيح.", "tr": "ʔana mnīḥ.", "en": "I'm fine." },
      { "text": "هِيِّ مِن سوريا.", "tr": "hiyye min Sūrya.", "en": "She's from Syria." }
    ], "drills": [
      { "id": "nc1", "prompt": "Say: I'm fine, thank God.", "answer": "أَنا مْنيح، الحَمدِلله.", "tr": "ʔana mnīḥ, il-ḥamdilla." },
      { "id": "nc2", "prompt": "Say: She's from Syria.", "answer": "هِيِّ مِن سوريا.", "tr": "hiyye min Sūrya." },
      { "id": "nc3", "prompt": "Ask a man: Where are you from?", "answer": "إنتَ مْنين؟", "tr": "inta mnēn?" }
    ], "verified": false },
    { "id": "gender", "title": "Masculine and feminine", "concept": "gender", "body": [
      "Most feminine nouns and adjectives end in **ـة** (said -a or -e): ṭālib → ṭālbe, mnīḥ → mnīḥa.",
      "Adjectives follow the noun and agree with it: **madīne ḥilwe** (a beautiful city: madīne is feminine)."
    ], "examples": [
      { "text": "هُوِّ طالِب، وهِيِّ طالْبة.", "tr": "huwwe ṭālib, w hiyye ṭālbe.", "en": "He's a student and she's a student." },
      { "text": "المَدينة حِلوة.", "tr": "il-madīne ḥilwe.", "en": "The city is beautiful." }
    ], "drills": [
      { "id": "gd1", "prompt": "Say: She's a student.", "answer": "هِيِّ طالْبة.", "tr": "hiyye ṭālbe." },
      { "id": "gd2", "prompt": "Say: The city is beautiful.", "answer": "المَدينة حِلوة.", "tr": "il-madīne ḥilwe." },
      { "id": "gd3", "prompt": "Say (as a woman): I'm fine.", "answer": "أَنا مْنيحة.", "tr": "ʔana mnīḥa." }
    ], "verified": false },
    { "id": "nisba", "title": "Nationality adjectives: -i / -iyye", "body": [
      "Add **-i** to a place to make 'from there': Libnān → libnāni, Sūrya → sūri, ʕarab → ʕarabi. The feminine is **-iyye**: libnāniyye.",
      "Same idea as Spanish -ano/-ana, and it's where English 'Iraqi, Yemeni' come from."
    ], "examples": [
      { "text": "هُوِّ لِبناني.", "tr": "huwwe libnāni.", "en": "He's Lebanese." },
      { "text": "هِيِّ أَميركانية.", "tr": "hiyye ʔamērkāniyye.", "en": "She's American." }
    ], "drills": [
      { "id": "ns1", "prompt": "Say: He's Lebanese.", "answer": "هُوِّ لِبناني.", "tr": "huwwe libnāni." },
      { "id": "ns2", "prompt": "Say: She's Syrian.", "answer": "هِيِّ سورية.", "tr": "hiyye sūriyye." },
      { "id": "ns3", "prompt": "Say: I'm not American (m).", "answer": "أَنا مِش أَميركاني.", "tr": "ʔana mish ʔamērkāni." }
    ], "verified": false },
    { "id": "bidd", "title": "bidd- 'want'", "body": [
      "'Want' is **bidd-** plus a possessive ending: biddi (I), biddak (you m), biddik (you f), biddo (he), bidda (she), biddna (we), biddkon (you pl), biddhon (they).",
      "Negate with **mā**: mā biddi = I don't want. Followed by a verb, the verb loses its b-: biddi rūḥ = I want to go (Unit 11)."
    ], "examples": [
      { "text": "بِدّي قَهوة.", "tr": "biddi ʔahwe.", "en": "I want coffee." },
      { "text": "شو بِدِّك؟", "tr": "shū biddik?", "en": "What do you (f) want?" },
      { "text": "ما بِدّي شي، شُكرًا.", "tr": "mā biddi shī, shukran.", "en": "I don't want anything, thanks." }
    ], "drills": [
      { "id": "bd1", "prompt": "Say: I'd like coffee, please (to a man).", "answer": "بِدّي قَهوة، لَو سَمَحت.", "tr": "biddi ʔahwe, law samaḥt." },
      { "id": "bd2", "prompt": "Ask a man: Do you want tea?", "answer": "بِدَّك شاي؟", "tr": "biddak shāy?" },
      { "id": "bd3", "prompt": "Say: She wants water.", "answer": "بِدّا مَي.", "tr": "bidda mayy." },
      { "id": "bd4", "prompt": "Say: I don't want sugar.", "answer": "ما بِدّي سُكَّر.", "tr": "mā biddi sukkar." }
    ], "verified": false },
    { "id": "ind", "title": "ʕind- 'have'", "body": [
      "'Have' is the preposition **ʕind** ('at') + an ending: ʕindi, ʕindak, ʕindik, ʕindo, ʕinda, ʕinna, ʕindkon, ʕindhon. Literally 'at me (is) a question'.",
      "Negate with mā: **mā ʕindi** = I don't have."
    ], "examples": [
      { "text": "عِندي سُؤال.", "tr": "ʕindi suʔāl.", "en": "I have a question." },
      { "text": "ما عِندي شُغل اليوم.", "tr": "mā ʕindi shughl il-yōm.", "en": "I don't have work today." }
    ], "drills": [
      { "id": "in1", "prompt": "Say: I have a lot of work.", "answer": "عِندي شُغل كْتير.", "tr": "ʕindi shughl ktīr." },
      { "id": "in2", "prompt": "Ask a woman: Do you have tea?", "answer": "عِندِك شاي؟", "tr": "ʕindik shāy?" },
      { "id": "in3", "prompt": "Say: I don't have bread.", "answer": "ما عِندي خِبز.", "tr": "mā ʕindi khibz." }
    ], "verified": false },
    { "id": "fi", "title": "fī 'there is' / mā fī 'there isn't'", "body": [
      "**fī** = there is / there are. Question: just raise your voice: fī ʔahwe? = Is there coffee?",
      "**mā fī** = there isn't. You'll hear 'mā fī mishkle': no problem."
    ], "examples": [
      { "text": "في شاي وقَهوة.", "tr": "fī shāy w ʔahwe.", "en": "There's tea and coffee." },
      { "text": "ما في مُشكِلة.", "tr": "mā fī mishkle.", "en": "No problem." }
    ], "drills": [
      { "id": "fi1", "prompt": "Ask: Is there sugar?", "answer": "في سُكَّر؟", "tr": "fī sukkar?" },
      { "id": "fi2", "prompt": "Say: There's no bread.", "answer": "ما في خِبز.", "tr": "mā fī khibz." },
      { "id": "fi3", "prompt": "Say: There's tea or coffee.", "answer": "في شاي وَلّا قَهوة.", "tr": "fī shāy walla ʔahwe." }
    ], "verified": false },
    { "id": "present", "title": "Present tense: b- + verb", "concept": "aspect", "body": [
      "Levantine present = **b-** + a person prefix + stem. For ʕ-r-f 'know': **baʕrif** I · **btaʕrif** you (m) · **btaʕrfi** you (f) · **byaʕrif** he · **btaʕrif** she · **mnaʕrif** we · **btaʕrfu** you (pl) · **byaʕrfu** they.",
      "Put **ʕam** in front for 'right now': ʕam badrus = I'm studying (at the moment).",
      "Negate with **mā**: mā baʕrif = I don't know."
    ], "examples": [
      { "text": "بِشرَب قَهوة كِل يَوم.", "tr": "bishrab ʔahwe kill yōm.", "en": "I drink coffee every day." },
      { "text": "عَم بَدرُس هَلَّق.", "tr": "ʕam badrus hallaʔ.", "en": "I'm studying now." },
      { "text": "هُوِّ بيِحكي عَرَبي.", "tr": "huwwe byiḥki ʕarabi.", "en": "He speaks Arabic." }
    ], "drills": [
      { "id": "pt1", "prompt": "Say: I drink coffee every day.", "answer": "بِشرَب قَهوة كِل يَوم.", "tr": "bishrab ʔahwe kill yōm." },
      { "id": "pt2", "prompt": "Ask a man: Do you speak Arabic?", "answer": "بْتِحكي عَرَبي؟", "tr": "btiḥki ʕarabi?" },
      { "id": "pt3", "prompt": "Say: We go to the university.", "answer": "مْنروح عالجامْعة.", "tr": "mnrūḥ ʕal-jāmʕa." },
      { "id": "pt4", "prompt": "Say: I don't understand.", "answer": "ما بِفهَم.", "tr": "mā bifham." },
      { "id": "pt5", "prompt": "Say: I'm studying right now.", "answer": "عَم بَدرُس هَلَّق.", "tr": "ʕam badrus hallaʔ." }
    ], "verified": false },
    { "id": "questions", "title": "Asking questions", "body": [
      "Question words: **shū** what · **mīn** who · **wēn** where · **mnēn** from where · **kīf** how · **lēsh** why · **ʔēmta** when · **ʔaddēsh** how much · **kam** how many.",
      "They can go first or last: **shū btaʕmel?** or **btaʕmel shū?** Yes/no questions just use rising intonation."
    ], "examples": [
      { "text": "لَيش بْتِدرُس طِبّ؟", "tr": "lēsh btidrus ṭibb?", "en": "Why do you study medicine?" },
      { "text": "إنتِ مْنين؟", "tr": "inti mnēn?", "en": "Where are you (f) from?" }
    ], "drills": [
      { "id": "qs1", "prompt": "Ask a man: What are you doing?", "answer": "شو بْتَعمِل؟", "tr": "shū btaʕmel?" },
      { "id": "qs2", "prompt": "Ask: When are you (m) coming?", "answer": "إيمتى بْتِجي؟", "tr": "ʔēmta btiji?" },
      { "id": "qs3", "prompt": "Ask: How much is this?", "answer": "قَدّيش هادا؟", "tr": "ʔaddēsh hāda?" },
      { "id": "qs4", "prompt": "Ask a man: Why do you study Arabic?", "answer": "لَيش بْتِدرُس عَرَبي؟", "tr": "lēsh btidrus ʕarabi?" }
    ], "verified": false }
  ],
  "texts": [
    { "id": "d01", "title": "Meeting at the conversation table", "level": "U1", "v": "lev", "kind": "dialogue", "names": ["فينو", "ليلى", "الشام", "أميركا"], "lines": [
      { "sp": "Venu", "text": "مَرحَبا!", "tr": "marḥaba!", "en": "Hello!" },
      { "sp": "Layla", "text": "أَهلا! أَنا ليلى. شو اِسمَك؟", "tr": "ʔahlan! ʔana Layla. shū ismak?", "en": "Hi! I'm Layla. What's your name?" },
      { "sp": "Venu", "text": "اِسمي فينو. إنتِ مْنين؟", "tr": "ismi Venu. inti mnēn?", "en": "My name's Venu. Where are you from?" },
      { "sp": "Layla", "text": "أَنا مِن الشّام. وإنتَ؟", "tr": "ʔana min ish-Shām. w inta?", "en": "I'm from Damascus. And you?" },
      { "sp": "Venu", "text": "أَنا مِن أَميركا. تْشَرَّفنا!", "tr": "ʔana min ʔamērka. tsharrafna!", "en": "I'm from America. Nice to meet you!" },
      { "sp": "Layla", "text": "أَهلا وسَهلا. كِيفَك؟", "tr": "ʔahlan w sahlan. kīfak?", "en": "Welcome. How are you?" },
      { "sp": "Venu", "text": "مْنيح، الحَمدِلله. وإنتِ، كِيفِك؟", "tr": "mnīḥ, il-ḥamdilla. w inti, kīfik?", "en": "Fine, thank God. And you, how are you?" },
      { "sp": "Layla", "text": "مْنيحة، شُكرًا. يَلّا، مَع السَّلامة!", "tr": "mnīḥa, shukran. yalla, maʕ is-salāme!", "en": "Fine, thanks. OK, bye!" }
    ], "verified": false },
    { "id": "d02", "title": "What do you study?", "level": "U2", "v": "lev", "kind": "dialogue", "names": ["هوبكنز", "فينو", "ليلى"], "lines": [
      { "sp": "Venu", "text": "إنتِ طالْبة هون؟", "tr": "inti ṭālbe hōn?", "en": "Are you a student here?" },
      { "sp": "Layla", "text": "إي، أَنا طالْبة بِجامْعة هوبكنز.", "tr": "ʔē, ʔana ṭālbe b-jāmʕit Hopkins.", "en": "Yes, I'm a student at Hopkins." },
      { "sp": "Venu", "text": "شو بْتِدرُسي؟", "tr": "shū btidrusi?", "en": "What do you study?" },
      { "sp": "Layla", "text": "بَدرُس طِبّ. وإنتَ؟", "tr": "badrus ṭibb. w inta?", "en": "I study medicine. And you?" },
      { "sp": "Venu", "text": "وأَنا كَمان! بَس بَدرُس عَرَبي كَمان.", "tr": "w ʔana kamān! bass badrus ʕarabi kamān.", "en": "Me too! But I study Arabic too." },
      { "sp": "Layla", "text": "بْتِحكي عَرَبي؟", "tr": "btiḥki ʕarabi?", "en": "Do you speak Arabic?" },
      { "sp": "Venu", "text": "شْوَي. بَحكي إسباني وإنكليزي.", "tr": "shwayy. baḥki isbāni w inglīzi.", "en": "A little. I speak Spanish and English." },
      { "sp": "Layla", "text": "كْتير حِلو!", "tr": "ktīr ḥilu!", "en": "Very nice!" }
    ], "verified": false },
    { "id": "d03", "title": "At the café", "level": "U3", "v": "lev", "kind": "dialogue", "lines": [
      { "sp": "Waiter", "text": "أَهلا وسَهلا! شو بِدَّك؟", "tr": "ʔahlan w sahlan! shū biddak?", "en": "Welcome! What would you like?" },
      { "sp": "You", "text": "بِدّي قَهوة، لَو سَمَحت.", "tr": "biddi ʔahwe, law samaḥt.", "en": "I'd like a coffee, please." },
      { "sp": "Waiter", "text": "مَع سُكَّر وَلّا بَلا؟", "tr": "maʕ sukkar walla bala?", "en": "With sugar or without?" },
      { "sp": "You", "text": "بَلا سُكَّر. في خِبز؟", "tr": "bala sukkar. fī khibz?", "en": "Without sugar. Is there bread?" },
      { "sp": "Waiter", "text": "لأ، ما في خِبز اليوم. بَس في عَصير.", "tr": "laʔ, mā fī khibz il-yōm. bass fī ʕaṣīr.", "en": "No, there's no bread today. But there's juice." },
      { "sp": "You", "text": "طَيِّب، وعَصير كَمان. قَدّيش هادا؟", "tr": "ṭayyib, w ʕaṣīr kamān. ʔaddēsh hāda?", "en": "OK, and a juice too. How much is that?" },
      { "sp": "Waiter", "text": "ما في مُشكِلة، بَعدين. صَحتين!", "tr": "mā fī mishkle, baʕdēn. ṣaḥtēn!", "en": "No problem, later. Enjoy!" }
    ], "verified": false },
    { "id": "d04", "title": "My day", "level": "U4", "v": "lev", "kind": "reading", "names": ["فينو", "هوبكنز"], "lines": [
      { "text": "أَنا فينو، طالِب بِجامْعة هوبكنز.", "tr": "ʔana Venu, ṭālib b-jāmʕit Hopkins.", "en": "I'm Venu, a student at Hopkins." },
      { "text": "كِل يَوم بْروح عالجامْعة.", "tr": "kill yōm brūḥ ʕal-jāmʕa.", "en": "Every day I go to the university." },
      { "text": "بَدرُس طِبّ، وبَدرُس عَرَبي كَمان.", "tr": "badrus ṭibb, w badrus ʕarabi kamān.", "en": "I study medicine, and I study Arabic too." },
      { "text": "بحِبّ العَرَبي كْتير، بَس شْوَي صَعب.", "tr": "bḥibb il-ʕarabi ktīr, bass shwayy ṣaʕb.", "en": "I love Arabic a lot, but it's a bit hard." },
      { "text": "بِشرَب قَهوة كْتير، لَإنّو عِندي شُغل كْتير.", "tr": "bishrab ʔahwe ktīr, laʔinno ʕindi shughl ktīr.", "en": "I drink a lot of coffee, because I have a lot of work." },
      { "text": "هَلَّق عَم بَدرُس. يَلّا، مَع السَّلامة!", "tr": "hallaʔ ʕam badrus. yalla, maʕ is-salāme!", "en": "Right now I'm studying. OK, bye!" }
    ], "verified": false }
  ]
