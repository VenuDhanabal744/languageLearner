  "words": [
    { "id": "marhaba", "text": "مَرحَبا", "tr": "marḥaba", "en": "hello", "pos": "interj", "ex": { "text": "مَرحَبا، أَنا فينو.", "tr": "marḥaba, ʔana Venu.", "en": "Hello, I'm Venu." }, "verified": false },
    { "id": "ahlan", "text": "أَهلا", "tr": "ʔahlan", "en": "hi / welcome", "pos": "interj", "forms": ["سهلا", "أهلين"], "ex": { "text": "أَهلا وسَهلا!", "tr": "ʔahlan w sahlan!", "en": "Welcome!" }, "verified": false },
    { "id": "ana", "text": "أَنا", "tr": "ʔana", "en": "I", "pos": "pron", "ex": { "text": "أَنا مْنيح.", "tr": "ʔana mnīḥ.", "en": "I'm fine." }, "verified": false },
