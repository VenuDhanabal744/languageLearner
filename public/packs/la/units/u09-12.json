    { "id": "inter", "text": "inter", "tr": "IN·ter", "en": "between, among (+acc.)", "pos": "prep", "cognates": { "es": "entre", "en": "inter-" }, "ex": { "text": "Inter amīcōs sum.", "en": "I am among friends." }, "verified": false },
