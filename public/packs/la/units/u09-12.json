    { "id": "principium", "text": "prīncipium", "tr": "prīn·KI·pi·um", "en": "beginning", "pos": "noun", "forms": ["prīncipiō", "prīncipiī"], "cognates": { "es": "principio" }, "ex": { "text": "In prīncipiō erat lūx.", "en": "In the beginning there was light." }, "verified": false },
