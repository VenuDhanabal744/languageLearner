    { "id": "laboro", "text": "labōrō", "tr": "la·BŌ·rō", "en": "I work", "pos": "verb", "forms": ["labōrat", "labōrant", "labōrās", "labōrāmus", "labōrāre"], "cognates": { "es": "laborar", "en": "labor" }, "ex": { "text": "Pater in oppidō labōrat.", "en": "Father works in the town." }, "verified": false },
    { "id": "habito", "text": "habitō", "tr": "HA·bi·tō", "en": "I live (dwell)", "pos": "verb", "forms": ["habitat", "habitant", "habitās", "habitāre", "habitābat"], "cognates": { "es": "habitar", "en": "inhabit" }, "ex": { "text": "Ubi habitās? In Americā habitō.", "en": "Where do you live? I live in America." }, "verified": false },
    { "id": "ambulo", "text": "ambulō", "tr": "AM·bu·lō", "en": "I walk", "pos": "verb", "forms": ["ambulat", "ambulant", "ambulāmus", "ambulās", "ambulāre"], "cognates": { "en": "ambulance, amble" }, "ex": { "text": "Puer in viā ambulat.", "en": "The boy walks in the street." }, "verified": false },
    { "id": "canto", "text": "cantō", "tr": "KAN·tō", "en": "I sing", "pos": "verb", "forms": ["cantat", "cantant", "cantās", "cantāre", "cantāvimus"], "cognates": { "es": "cantar", "en": "chant" }, "ex": { "text": "Puella cantat.", "en": "The girl sings." }, "verified": false },
    { "id": "specto", "text": "spectō", "tr": "SPEK·tō", "en": "I look at, watch", "pos": "verb", "forms": ["spectat", "spectant", "spectāre"], "cognates": { "en": "spectator" }, "ex": { "text": "Mārcus puellam spectat.", "en": "Marcus looks at the girl." }, "verified": false },
    { "id": "video", "text": "videō", "tr": "WI·de·ō", "en": "I see", "pos": "verb", "forms": ["vidēs", "videt", "vidēmus", "vident", "vidēre", "vīdī", "vīdit"], "cognates": { "es": "ver", "en": "video, vision" }, "ex": { "text": "Quid vidēs? Fluvium videō.", "en": "What do you see? I see a river." }, "verified": false },
    { "id": "timeo", "text": "timeō", "tr": "TI·me·ō", "en": "I fear", "pos": "verb", "forms": ["timet", "timent", "timēre", "timēbat", "nōlī"], "cognates": { "es": "temer", "en": "timid" }, "ex": { "text": "Puer canem timet.", "en": "The boy is afraid of the dog." }, "verified": false },
    { "id": "rideo", "text": "rīdeō", "tr": "RĪ·de·ō", "en": "I laugh, smile", "pos": "verb", "forms": ["rīdēs", "rīdet", "rīdent", "rīdēre", "rīsit", "rīdēbāmus"], "cognates": { "es": "reír", "en": "ridiculous" }, "ex": { "text": "Cūr rīdēs?", "en": "Why are you laughing?" }, "verified": false },
    { "id": "respondeo", "text": "respondeō", "tr": "re·SPON·de·ō", "en": "I answer", "pos": "verb", "forms": ["respondet", "respondent", "respondēre", "respondit", "respondē"], "cognates": { "es": "responder" }, "ex": { "text": "Mārcus nōn respondet.", "en": "Marcus doesn't answer." }, "verified": false },
    { "id": "sedeo", "text": "sedeō", "tr": "SE·de·ō", "en": "I sit", "pos": "verb", "forms": ["sedet", "sedent", "sedēre", "sēdit"], "cognates": { "en": "sedentary" }, "ex": { "text": "Pater in hortō sedet.", "en": "Father is sitting in the garden." }, "verified": false },
    { "id": "doceo", "text": "doceō", "tr": "DO·ke·ō", "en": "I teach", "pos": "verb", "forms": ["docet", "docent", "docēre"], "cognates": { "en": "doctor, docent" }, "ex": { "text": "Magister discipulōs docet.", "en": "The teacher teaches the students." }, "verified": false },
    { "id": "hodie", "text": "hodiē", "tr": "HO·di·ē", "en": "today", "pos": "adv", "cognates": { "es": "hoy" }, "ex": { "text": "Hodiē labōrō.", "en": "Today I'm working." }, "verified": false },
    { "id": "saepe", "text": "saepe", "tr": "SAE·pe", "en": "often", "pos": "adv", "ex": { "text": "Mārcus saepe rīdet.", "en": "Marcus often laughs." }, "verified": false },
    { "id": "semper", "text": "semper", "tr": "SEM·per", "en": "always", "pos": "adv", "cognates": { "es": "siempre (ĕ → ie)" }, "ex": { "text": "Māter semper labōrat.", "en": "Mother is always working." }, "verified": false },
    { "id": "numquam", "text": "numquam", "tr": "NUM·kwam", "en": "never", "pos": "adv", "cognates": { "es": "nunca" }, "ex": { "text": "Pater numquam cantat.", "en": "Father never sings." }, "verified": false },
    { "id": "nunc", "text": "nunc", "tr": "nunk", "en": "now", "pos": "adv", "ex": { "text": "Nunc ambulāmus.", "en": "Now we are walking." }, "verified": false },
    { "id": "cur", "text": "cūr", "tr": "kūr", "en": "why?", "pos": "q", "ex": { "text": "Cūr nōn cantās?", "en": "Why don't you sing?" }, "verified": false },
    { "id": "quia", "text": "quia", "tr": "KWI·a", "en": "because", "pos": "conj", "ex": { "text": "Rīdeō quia laetus sum.", "en": "I laugh because I am happy." }, "verified": false },
    { "id": "ibi", "text": "ibi", "tr": "I·bi", "en": "there", "pos": "adv", "ex": { "text": "Rōma magna est; ibi multī habitant.", "en": "Rome is big; many people live there." }, "verified": false },
    { "id": "etiam", "text": "etiam", "tr": "E·ti·am", "en": "also, even", "pos": "adv", "ex": { "text": "Ego etiam labōrō.", "en": "I work too." }, "verified": false }
  ],
  "grammar": [
    { "id": "esse", "title": "esse 'to be': sum, es, est…", "concept": "copula-zero", "body": [
      "**sum** I am · **es** you are · **est** he/she/it is · **sumus** we are · **estis** you (pl.) are · **sunt** they are. Compare Spanish soy, eres, es, somos, sois, son.",
      "Latin drops subject pronouns as Spanish does: **sum Mārcus** = I am Marcus. The verb usually comes last: **Mārcus Rōmānus est**."
    ], "examples": [
      { "text": "Discipulī sumus.", "en": "We are students." },
      { "text": "Mārcus et Iūlia Rōmānī sunt.", "en": "Marcus and Julia are Romans." }
    ], "drills": [
      { "id": "es1", "prompt": "Say: I am Marcus.", "answer": "Sum Mārcus." },
      { "id": "es2", "prompt": "Say: We are students.", "answer": "Discipulī sumus." },
      { "id": "es3", "prompt": "Say: They are not Romans.", "answer": "Nōn sunt Rōmānī." },
      { "id": "es4", "prompt": "Say: You are a student (to one person).", "answer": "Discipulus es." }
    ], "verified": false },
    { "id": "questions", "title": "Questions: quis, quid, -ne", "body": [
      "Question words: **quis** who · **quid** what · **ubi** where · **cūr** why.",
      "Yes/no questions add **-ne** to the first word: **Esne Rōmānus?** Are you Roman? Answer **ita** (yes) or **minimē** (not at all), or repeat the verb: **sum** / **nōn sum**."
    ], "examples": [
      { "text": "Esne discipulus? Ita, discipulus sum.", "en": "Are you a student? Yes, I am a student." },
      { "text": "Quid agis? Bene valeō.", "en": "How are you? I'm well." }
    ], "drills": [
      { "id": "qu1", "prompt": "Ask: Who are you?", "answer": "Quis es?" },
      { "id": "qu2", "prompt": "Ask: Are you Roman? (-ne)", "answer": "Esne Rōmānus?" },
      { "id": "qu3", "prompt": "Ask: How are you?", "answer": "Quid agis?" },
      { "id": "qu4", "prompt": "Answer: Not at all, I am not Roman.", "answer": "Minimē, nōn sum Rōmānus." }
    ], "verified": false },
    { "id": "decl12", "title": "Nouns in -a, -us, -um (singular and plural)", "concept": "gender", "body": [
      "Most nouns in **-a** are feminine (īnsula), most in **-us** masculine (fluvius), in **-um** neuter (oppidum). Plurals: **-a → -ae**, **-us → -ī**, **-um → -a**.",
      "Adjectives agree, like Spanish: **īnsula parva**, **fluvius magnus**, **oppidum parvum**; plural **īnsulae parvae, fluviī magnī, oppida parva**."
    ], "examples": [
      { "text": "Īnsulae parvae sunt, sed fluviī magnī sunt.", "en": "The islands are small, but the rivers are big." }
    ], "drills": [
      { "id": "d1", "prompt": "Say: The island is small.", "answer": "Īnsula parva est." },
      { "id": "d2", "prompt": "Say: The islands are small.", "answer": "Īnsulae parvae sunt." },
      { "id": "d3", "prompt": "Say: The rivers are big.", "answer": "Fluviī magnī sunt." },
      { "id": "d4", "prompt": "Say: The towns are small.", "answer": "Oppida parva sunt." }
    ], "verified": false },
    { "id": "sound1", "title": "From Latin to Spanish (1): vowels and f-", "body": [
      "Stressed short **ĕ → ie**: terra → tierra, bene → bien, semper → siempre, tempus → tiempo.",
      "Stressed short **ŏ → ue**: porta → puerta, bonus → bueno, hortus → huerto, mors → muerte.",
      "Initial **f- → h-**: fīlius → hijo, facere → hacer, fābulārī → hablar, fēmina → hembra.",
      "Use it backwards: when a Latin word looks strange, undo the change and you'll often recognise it."
    ], "examples": [
      { "text": "Terra bona est.", "en": "The land is good. (tierra buena)" }
    ], "drills": [
      { "id": "s1", "prompt": "Spanish 'tierra' comes from Latin…", "answer": "terra" },
      { "id": "s2", "prompt": "Spanish 'bueno' comes from Latin…", "answer": "bonus" },
      { "id": "s3", "prompt": "Spanish 'hijo' comes from Latin…", "answer": "fīlius" },
      { "id": "s4", "prompt": "Spanish 'siempre' comes from Latin…", "answer": "semper" }
    ], "verified": false },
    { "id": "genitive", "title": "Whose? The genitive: -ae, -ī, -is", "concept": "cases", "body": [
      "The genitive means 'of': **fīlius Iūliī** = the son of Julius; **māter puellae** = the girl's mother; **familia Mārcī** = Marcus's family.",
      "Endings: **-a → -ae**, **-us/-um → -ī**, third declension **-is** (pater → patris). Dictionaries list the genitive second because it shows the stem: pater, **patris**."
    ], "examples": [
      { "text": "Mārcus frāter Iūliae est.", "en": "Marcus is Julia's brother." },
      { "text": "Domus patris magna est.", "en": "Father's house is big." }
    ], "drills": [
      { "id": "g1", "prompt": "Say: the son of Julius", "answer": "fīlius Iūliī" },
      { "id": "g2", "prompt": "Say: the girl's mother", "answer": "māter puellae" },
      { "id": "g3", "prompt": "Say: Marcus's family", "answer": "familia Mārcī" },
      { "id": "g4", "prompt": "Ask: Whose daughter is Julia?", "answer": "Cuius fīlia est Iūlia?" }
    ], "verified": false },
    { "id": "possessive", "title": "My, your: meus, tuus", "body": [
      "**meus, mea, meum** = my; **tuus, tua, tuum** = your (one person). They agree with the thing owned and usually follow it: **māter mea**, **pater meus**, **domus mea** (domus is feminine).",
      "Spanish keeps both orders: mi madre / la madre mía."
    ], "examples": [
      { "text": "Frāter meus et soror mea discipulī sunt.", "en": "My brother and my sister are students." }
    ], "drills": [
      { "id": "p1", "prompt": "Say: my mother", "answer": "māter mea" },
      { "id": "p2", "prompt": "Say: my father", "answer": "pater meus" },
      { "id": "p3", "prompt": "Say: your brother", "answer": "frāter tuus" },
      { "id": "p4", "prompt": "Say: my house", "answer": "domus mea" }
    ], "verified": false },
    { "id": "present12", "title": "Present tense: amō, videō", "body": [
      "1st conjugation: **amō, amās, amat, amāmus, amātis, amant**. Spanish: amo, amas, ama, amamos, amáis, aman.",
      "2nd conjugation: **videō, vidēs, videt, vidēmus, vidētis, vident**.",
      "Negate with **nōn** before the verb: **nōn cantō**."
    ], "examples": [
      { "text": "Labōrāmus, sed nōn cantāmus.", "en": "We work, but we don't sing." }
    ], "drills": [
      { "id": "pr1", "prompt": "Say: She sings.", "answer": "Cantat." },
      { "id": "pr2", "prompt": "Say: We work.", "answer": "Labōrāmus." },
      { "id": "pr3", "prompt": "Say: They see the river.", "answer": "Fluvium vident." },
      { "id": "pr4", "prompt": "Say: I don't laugh.", "answer": "Nōn rīdeō." },
      { "id": "pr5", "prompt": "Ask: Do you live in America? (-ne)", "answer": "Habitāsne in Americā?" }
    ], "verified": false },
    { "id": "accusative", "title": "The object: accusative -am, -um, -ās, -ōs", "concept": "cases", "body": [
      "The direct object takes the accusative: **-a → -am**, **-us → -um**, plural **-ās, -ōs**, neuter stays **-um / -a**.",
      "Because the ending marks the object, word order is free: **Māter puellam vocat** = **Puellam māter vocat** = the mother calls the girl. The verb usually comes last.",
      "Spanish nouns come from the accusative: noctem → noche, partem → parte."
    ], "examples": [
      { "text": "Puer puellam videt, et puella puerum videt.", "en": "The boy sees the girl, and the girl sees the boy." }
    ], "drills": [
      { "id": "ac1", "prompt": "Say: The mother calls the girl.", "answer": "Māter puellam vocat." },
      { "id": "ac2", "prompt": "Say: Marcus sees the boys.", "answer": "Mārcus puerōs videt." },
      { "id": "ac3", "prompt": "Say: The boy loves the girl.", "answer": "Puer puellam amat." },
      { "id": "ac4", "prompt": "Say: Julia sees the towns.", "answer": "Iūlia oppida videt." }
    ], "verified": false }
  ],
  "texts": [
    { "id": "d01", "title": "Salvē! Quis es?", "level": "U1", "kind": "dialogue", "names": ["Mārcus", "Mārce", "Venu"], "lines": [
      { "sp": "Mārcus", "text": "Salvē! Quis es tū?", "en": "Hello! Who are you?" },
      { "sp": "Venu", "text": "Salvē! Mihi nōmen est Venu. Et tū?", "en": "Hello! My name is Venu. And you?" },
      { "sp": "Mārcus", "text": "Ego sum Mārcus. Quid agis?", "en": "I am Marcus. How are you?" },
      { "sp": "Venu", "text": "Bene, grātiās. Et tū?", "en": "Well, thanks. And you?" },
      { "sp": "Mārcus", "text": "Bene valeō. Esne Rōmānus?", "en": "I'm well. Are you Roman?" },
      { "sp": "Venu", "text": "Minimē! Nōn sum Rōmānus. Discipulus sum.", "en": "Not at all! I'm not Roman. I'm a student." },
      { "sp": "Mārcus", "text": "Et ego discipulus sum!", "en": "I'm a student too!" },
      { "sp": "Venu", "text": "Valē, Mārce!", "en": "Goodbye, Marcus!" },
      { "sp": "Mārcus", "text": "Valē!", "en": "Goodbye!" }
    ], "verified": false },
    { "id": "r01", "title": "Rōma et Hispānia", "level": "U2", "kind": "reading", "names": ["Rōma", "Sicilia", "Tiberis", "Baltimora", "Americā"], "lines": [
      { "text": "Rōma in Italiā est. Italia in Eurōpā est.", "en": "Rome is in Italy. Italy is in Europe." },
      { "text": "Hispānia quoque in Eurōpā est. Hispānia terra magna est.", "en": "Spain is also in Europe. Spain is a big country." },
      { "text": "Graecia in Eurōpā est, sed Graecia nōn magna est.", "en": "Greece is in Europe, but Greece is not big." },
      { "text": "In Graeciā multae īnsulae sunt.", "en": "In Greece there are many islands." },
      { "text": "Sicilia īnsula est. Sicilia nōn parva est; Sicilia īnsula magna est.", "en": "Sicily is an island. Sicily is not small; Sicily is a big island." },
      { "text": "Tiberis fluvius est. Tiberis in Italiā est.", "en": "The Tiber is a river. The Tiber is in Italy." },
      { "text": "Ubi est Baltimora? Baltimora nōn in Eurōpā est. Baltimora in Americā est!", "en": "Where is Baltimore? Baltimore is not in Europe. Baltimore is in America!" }
    ], "verified": false },
    { "id": "r02", "title": "Familia Iūliī", "level": "U3", "kind": "reading", "names": ["Iūlius", "Iūliī", "Aemilia", "Mārcus", "Mārcī", "Quīntus", "Iūlia", "Iūliae"], "lines": [
      { "text": "Iūlius vir Rōmānus est. Aemilia fēmina Rōmāna est.", "en": "Julius is a Roman man. Aemilia is a Roman woman." },
      { "text": "Iūlius pater est, Aemilia māter est.", "en": "Julius is the father, Aemilia is the mother." },
      { "text": "Mārcus et Quīntus fīliī sunt; Iūlia fīlia est.", "en": "Marcus and Quintus are the sons; Julia is the daughter." },
      { "text": "Mārcus puer est, Iūlia puella est.", "en": "Marcus is a boy, Julia is a girl." },
      { "text": "Mārcus frāter Iūliae est, et Iūlia soror Mārcī est.", "en": "Marcus is Julia's brother, and Julia is Marcus's sister." },
      { "text": "Iūlius trēs līberōs habet: duōs fīliōs et ūnam fīliam.", "en": "Julius has three children: two sons and one daughter." },
      { "text": "Familia Iūliī magna et bona est. Domus familiae in Italiā est.", "en": "Julius's family is big and good. The family's house is in Italy." }
    ], "verified": false },
    { "id": "d02", "title": "Ubi habitās?", "level": "U4", "kind": "dialogue", "names": ["Venu", "Iūlia", "Baltimorā", "Americā"], "lines": [
      { "sp": "Iūlia", "text": "Salvē, Venu! Ubi habitās?", "en": "Hi, Venu! Where do you live?" },
      { "sp": "Venu", "text": "In Americā habitō, in oppidō Baltimorā.", "en": "I live in America, in the town of Baltimore." },
      { "sp": "Iūlia", "text": "Quid ibi agis?", "en": "What do you do there?" },
      { "sp": "Venu", "text": "Discipulus sum. Multum labōrō.", "en": "I'm a student. I work a lot." },
      { "sp": "Iūlia", "text": "Labōrāsne semper?", "en": "Do you always work?" },
      { "sp": "Venu", "text": "Minimē! Saepe ambulō et cantō.", "en": "Not at all! I often walk and sing." },
      { "sp": "Iūlia", "text": "Cantāsne? Ego numquam cantō!", "en": "You sing? I never sing!" },
      { "sp": "Venu", "text": "Cūr nōn cantās?", "en": "Why don't you sing?" },
      { "sp": "Iūlia", "text": "Quia frāter meus semper rīdet!", "en": "Because my brother always laughs!" }
    ], "verified": false }
  ]
}
