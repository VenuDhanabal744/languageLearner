    { "id": "lux", "text": "lūx", "tr": "lūks", "en": "light (gen. lūcis)", "pos": "noun", "forms": ["lūcis", "lūcem", "lūce"], "cognates": { "es": "luz", "en": "lucid" }, "ex": { "text": "Lūx in vīllā est.", "en": "There is light in the villa." }, "verified": false },
    { "id": "sol", "text": "sōl", "tr": "sōl", "en": "sun (gen. sōlis)", "pos": "noun", "forms": ["sōlis", "sōlem", "sōle"], "cognates": { "es": "sol", "en": "solar" }, "ex": { "text": "Sōl magnus est.", "en": "The sun is big." }, "verified": false },
    { "id": "mare", "text": "mare", "tr": "MA·re", "en": "sea (gen. maris)", "pos": "noun", "forms": ["maris", "marī", "maria"], "cognates": { "es": "mar", "en": "marine" }, "ex": { "text": "Sicilia in marī est.", "en": "Sicily is in the sea." }, "verified": false },
    { "id": "urbs", "text": "urbs", "tr": "urbs", "en": "city (gen. urbis)", "pos": "noun", "forms": ["urbis", "urbem", "urbe", "urbēs", "urbium"], "cognates": { "en": "urban" }, "ex": { "text": "Rōma urbs magna est.", "en": "Rome is a big city." }, "verified": false },
    { "id": "civis", "text": "cīvis", "tr": "KĪ·wis", "en": "citizen", "pos": "noun", "forms": ["cīvēs", "cīvem", "cīvium", "cīvibus"], "cognates": { "es": "civil", "en": "civic" }, "ex": { "text": "Cīvis Rōmānus sum.", "en": "I am a Roman citizen." }, "verified": false },
    { "id": "canis", "text": "canis", "tr": "KA·nis", "en": "dog", "pos": "noun", "forms": ["canem", "canēs", "canī", "cane"], "cognates": { "es": "can", "en": "canine" }, "ex": { "text": "Canis in hortō currit.", "en": "The dog runs in the garden." }, "verified": false },
    { "id": "tempus", "text": "tempus", "tr": "TEM·pus", "en": "time (gen. temporis)", "pos": "noun", "forms": ["temporis", "tempore", "tempora"], "cognates": { "es": "tiempo (ĕ → ie)", "en": "temporal" }, "ex": { "text": "Tempus fugit.", "en": "Time flies." }, "verified": false },
    { "id": "mons", "text": "mōns", "tr": "mōns", "en": "mountain (gen. montis)", "pos": "noun", "forms": ["montis", "montem", "monte", "montēs"], "cognates": { "es": "monte", "en": "mount" }, "ex": { "text": "Vesuvius mōns est.", "en": "Vesuvius is a mountain." }, "verified": false },
    { "id": "altus", "text": "altus", "tr": "AL·tus", "en": "high, tall, deep", "pos": "adj", "forms": ["alta", "altum"], "cognates": { "es": "alto", "en": "altitude" }, "ex": { "text": "Mōns altus est.", "en": "The mountain is high." }, "verified": false },
    { "id": "flumen", "text": "flūmen", "tr": "FLŪ·men", "en": "river (gen. flūminis)", "pos": "noun", "forms": ["flūminis", "flūmine", "flūmina"], "ex": { "text": "Tiberis flūmen Rōmae est.", "en": "The Tiber is Rome's river." }, "verified": false },
    { "id": "pax", "text": "pāx", "tr": "pāks", "en": "peace (gen. pācis)", "pos": "noun", "forms": ["pācis", "pācem", "pāce"], "cognates": { "es": "paz", "en": "peace" }, "ex": { "text": "Pāx tēcum!", "en": "Peace be with you!" }, "verified": false },
