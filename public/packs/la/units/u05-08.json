    { "id": "miles", "text": "mīles", "tr": "MĪ·les", "en": "soldier (gen. mīlitis)", "pos": "noun", "forms": ["mīlitis", "mīlitem", "mīlitēs", "mīlitum"], "cognates": { "en": "military" }, "ex": { "text": "Mīles in viā ambulat.", "en": "A soldier walks in the street." }, "verified": false },
