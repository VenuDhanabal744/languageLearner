    { "id": "mors", "text": "mors", "tr": "mors", "en": "death (gen. mortis)", "pos": "noun", "forms": ["mortis", "mortem", "morte"], "cognates": { "es": "muerte (ŏ → ue)", "en": "mortal" }, "ex": { "text": "Post mortem rēgis Rōma trīstis erat.", "en": "After the king's death Rome was sad." }, "verified": false }
