  "grammar": [
    { "id": "ablative", "title": "With, from, in: the ablative", "concept": "cases", "body": [
      "After **in** (in/on), **cum** (with), **sine** (without), **ab/ā** (from), **ex/ē** (out of), **dē** (about), **sub** (under), nouns take the ablative: **-a → -ā**, **-us/-um → -ō**, plural **-īs**.",
      "The ablative also works alone for 'by/with/at': **vōce pulchrā** = with a beautiful voice, **nocte** = at night."
    ], "examples": [
      { "text": "Mārcus cum amīcō in hortō ambulat.", "en": "Marcus walks in the garden with a friend." },
      { "text": "Puer ex vīllā sine cibō currit.", "en": "The boy runs out of the villa without food." }
    ], "drills": [
      { "id": "ab1", "prompt": "Say: with a friend", "answer": "cum amīcō" },
      { "id": "ab2", "prompt": "Say: without water", "answer": "sine aquā" },
      { "id": "ab3", "prompt": "Say: in the garden", "answer": "in hortō" },
      { "id": "ab4", "prompt": "Say: out of the villa", "answer": "ex vīllā" },
      { "id": "ab5", "prompt": "Say: about Rome", "answer": "dē Rōmā" }
    ], "verified": false },
    { "id": "in-acc-abl", "title": "in + ablative (where) vs in + accusative (where to)", "concept": "cases", "body": [
      "**in hortō** = in the garden (location, ablative). **in hortum** = into the garden (motion, accusative). Spanish uses 'en' and 'a' for this; Latin uses the ending.",
      "**ad, per, ante, post** always take the accusative: **ad scholam**, **per hortum**, **ante vīllam**."
    ], "examples": [
      { "text": "Puer in vīllam currit; nunc in vīllā est.", "en": "The boy runs into the villa; now he is in the villa." }
    ], "drills": [
      { "id": "ia1", "prompt": "Say: in the villa", "answer": "in vīllā" },
      { "id": "ia2", "prompt": "Say: into the villa", "answer": "in vīllam" },
      { "id": "ia3", "prompt": "Say: to the school", "answer": "ad scholam" },
      { "id": "ia4", "prompt": "Say: through the garden", "answer": "per hortum" }
    ], "verified": false },
    { "id": "dative", "title": "To whom? The dative", "concept": "dative", "body": [
      "The person something is given, shown or told to takes the dative: **-a → -ae**, **-us → -ō**, plural **-īs**, third declension **-ī** (patrī).",
      "**Puella poētae rosam dat** = the girl gives the poet a rose (Spanish: le da una rosa al poeta). Also 'dear/pleasing to': **mihi cāra est**."
    ], "examples": [
      { "text": "Pater fīliō pecūniam dat.", "en": "Father gives money to his son." },
      { "text": "Magister discipulīs fābulam nārrat.", "en": "The teacher tells the students a story." }
    ], "drills": [
      { "id": "da1", "prompt": "Say: The girl gives the poet a rose.", "answer": "Puella poētae rosam dat." },
      { "id": "da2", "prompt": "Say: Father gives his son money.", "answer": "Pater fīliō pecūniam dat." },
      { "id": "da3", "prompt": "Say: The teacher shows the students the way.", "answer": "Magister discipulīs viam mōnstrat." },
      { "id": "da4", "prompt": "Say: My sister is dear to me.", "answer": "Soror mea mihi cāra est." }
    ], "verified": false },
    { "id": "masc-a", "title": "Masculine nouns in -a", "concept": "gender", "body": [
      "A few -a nouns are masculine because they name men's jobs: **nauta** (sailor), **poēta**, **agricola**. They decline like puella but take masculine adjectives: **nauta bonus**, **poētae bonī**.",
      "Gender is about agreement, not about the ending; the same is true in Spanish (el poeta, el día)."
    ], "examples": [
      { "text": "Nauta bonus et poēta laetus amīcī sunt.", "en": "The good sailor and the happy poet are friends." }
    ], "drills": [
      { "id": "ma1", "prompt": "Say: a good sailor", "answer": "nauta bonus" },
      { "id": "ma2", "prompt": "Say: the good poets", "answer": "poētae bonī" },
      { "id": "ma3", "prompt": "Say: The farmer is happy.", "answer": "Agricola laetus est." }
    ], "verified": false },
    { "id": "sound2", "title": "From Latin to Spanish (2): consonants", "body": [
      "**-ct- → -ch-**: noctem → noche, lactem → leche, octō → ocho, factum → hecho.",
      "**cl-, pl-, fl- → ll-**: clāmāre → llamar, plēnus → lleno, pluvia → lluvia, flamma → llama.",
      "**p, t, c between vowels → b, d, g**: lupus → lobo, vīta → vida, amīcus → amigo, aqua → agua.",
      "**-li-, -c(u)l- → j**: fīlius → hijo, oculus → ojo, folium → hoja."
    ], "examples": [
      { "text": "Nocte lupus in viā est.", "en": "At night a wolf is on the road. (noche, lobo, vía)" }
    ], "drills": [
      { "id": "sc1", "prompt": "Spanish 'noche' comes from Latin… (accusative)", "answer": "noctem" },
      { "id": "sc2", "prompt": "Spanish 'amigo' comes from Latin…", "answer": "amīcus" },
      { "id": "sc3", "prompt": "Spanish 'ojo' comes from Latin…", "answer": "oculus" },
      { "id": "sc4", "prompt": "Spanish 'lluvia' comes from Latin…", "answer": "pluvia" },
      { "id": "sc5", "prompt": "Spanish 'lobo' comes from Latin…", "answer": "lupus" }
    ], "verified": false },
    { "id": "present34", "title": "Present tense: dīcō, audiō, faciō", "body": [
      "3rd conjugation: **dīcō, dīcis, dīcit, dīcimus, dīcitis, dīcunt** (Spanish digo, dices, dice…).",
      "4th conjugation: **audiō, audīs, audit, audīmus, audītis, audiunt**.",
      "Mixed (-iō): **faciō, facis, facit, facimus, facitis, faciunt**. The dictionary form's infinitive tells you the group: amāre, vidēre, dīcere, audīre."
    ], "examples": [
      { "text": "Discipulī legunt, magister scrībit, canis dormit.", "en": "The students read, the teacher writes, the dog sleeps." }
    ], "drills": [
      { "id": "p34a", "prompt": "Ask: What are you saying?", "answer": "Quid dīcis?" },
      { "id": "p34b", "prompt": "Say: We are reading a book.", "answer": "Librum legimus." },
      { "id": "p34c", "prompt": "Say: They are coming.", "answer": "Veniunt." },
      { "id": "p34d", "prompt": "Say: I hear the teacher.", "answer": "Magistrum audiō." },
      { "id": "p34e", "prompt": "Say: She is writing a letter.", "answer": "Epistulam scrībit." }
    ], "verified": false },
    { "id": "imperative", "title": "Commands", "body": [
      "One person: the bare stem: **amā!** **vidē!** **lege!** **audī!** **venī!** **aperī!** Short irregulars: **dīc!** **fac!** **dūc!**",
      "Several people: add **-te**: **amāte, vidēte, legite, audīte, venīte, tacēte**.",
      "Don't…!: **nōlī** (to several: **nōlīte**) + infinitive: **nōlī timēre!** = don't be afraid!"
    ], "examples": [
      { "text": "Audīte, discipulī! Aperīte librōs et legite!", "en": "Listen, students! Open your books and read!" }
    ], "drills": [
      { "id": "im1", "prompt": "Say: Come, Marcus!", "answer": "Venī, Mārce!" },
      { "id": "im2", "prompt": "Say: Listen, students!", "answer": "Audīte, discipulī!" },
      { "id": "im3", "prompt": "Say (to one person): Read the book!", "answer": "Lege librum!" },
      { "id": "im4", "prompt": "Say: Don't be afraid! (to one person)", "answer": "Nōlī timēre!" }
    ], "verified": false },
    { "id": "decl3", "title": "Third declension: rēx, rēgis", "concept": "cases", "body": [
      "The nominative is unpredictable, but the genitive (-is) shows the stem: **rēx, rēgis**; **nox, noctis**; **homō, hominis**; **tempus, temporis**. Always learn both.",
      "Endings on the stem: acc. **-em**, gen. **-is**, dat. **-ī**, abl. **-e**; plural nom./acc. **-ēs**, gen. **-um/-ium**, dat./abl. **-ibus**.",
      "Neuters (**nōmen, tempus, mare, flūmen**): nominative = accusative; plural **-a** (tempora, flūmina)."
    ], "examples": [
      { "text": "Rēx urbem videt; cīvēs rēgem vident.", "en": "The king sees the city; the citizens see the king." }
    ], "drills": [
      { "id": "d3a", "prompt": "Say: the king's daughter", "answer": "fīlia rēgis" },
      { "id": "d3b", "prompt": "Say: at night (ablative)", "answer": "nocte" },
      { "id": "d3c", "prompt": "Say: I see the city.", "answer": "Urbem videō." },
      { "id": "d3d", "prompt": "Say: The citizens love peace.", "answer": "Cīvēs pācem amant." }
    ], "verified": false }
  ],
  "texts": [
    { "id": "r03", "title": "Vīlla", "level": "U5", "kind": "reading", "names": ["Iūliī", "Mārcus"], "lines": [
      { "text": "Familia Iūliī in vīllā habitat. Vīlla magna et pulchra est.", "en": "Julius's family lives in a villa. The villa is big and beautiful." },
      { "text": "Ante vīllam hortus est. In hortō multae rosae sunt.", "en": "In front of the villa is a garden. In the garden there are many roses." },
      { "text": "Pater in hortō labōrat; māter cum fīliā in vīllā est.", "en": "Father works in the garden; mother is in the villa with her daughter." },
      { "text": "Mārcus ā vīllā ad scholam ambulat. Liber in manū puerī est.", "en": "Marcus walks from the villa to school. A book is in the boy's hand." },
      { "text": "In scholā magister discipulōs docet.", "en": "At school the teacher teaches the students." },
      { "text": "Post scholam Mārcus cum amīcīs per viam ad vīllam ambulat.", "en": "After school Marcus walks along the road to the villa with his friends." },
      { "text": "In mēnsā cibus et aqua sunt. Familia laeta est.", "en": "On the table there is food and water. The family is happy." }
    ], "verified": false },
    { "id": "r04", "title": "Dōna", "level": "U6", "kind": "reading", "names": ["Iūlia", "Iūliae", "Mārcus", "Mārcō"], "lines": [
      { "text": "Hodiē Iūlia laeta est. Māter Iūliae dōnum dat: librum novum.", "en": "Today Julia is happy. Her mother gives Julia a gift: a new book." },
      { "text": "In librō multae fābulae sunt.", "en": "In the book there are many stories." },
      { "text": "Iūlia frātrī fābulam nārrat, fābulam dē nautā et rēgīnā.", "en": "Julia tells her brother a story, a story about a sailor and a queen." },
      { "text": "Nauta rēgīnae rosam dat. Rēgīna laeta est; rosa eī grāta est.", "en": "The sailor gives the queen a rose. The queen is happy; the rose pleases her." },
      { "text": "Mārcus rīdet: “Fābula longa est, sed bona!”", "en": "Marcus laughs: “The story is long, but good!”" },
      { "text": "Deinde pater Mārcō mālum dat, et Mārcus sorōrī mālum dat.", "en": "Then father gives Marcus an apple, and Marcus gives his sister the apple." }
    ], "verified": false },
    { "id": "d03", "title": "In scholā", "level": "U7", "kind": "dialogue", "names": ["Iūlia", "Mārce", "Mārcus", "Venu"], "lines": [
      { "sp": "Magister", "text": "Salvēte, discipulī!", "en": "Hello, students!" },
      { "sp": "Discipulī", "text": "Salvē, magister!", "en": "Hello, teacher!" },
      { "sp": "Magister", "text": "Hodiē fābulam legimus. Aperīte librōs!", "en": "Today we are reading a story. Open your books!" },
      { "sp": "Venu", "text": "Magister, quid dīcis? Nōn intellegō.", "en": "Teacher, what are you saying? I don't understand." },
      { "sp": "Magister", "text": "Aperīte librōs! Intellegisne nunc?", "en": "Open your books! Do you understand now?" },
      { "sp": "Venu", "text": "Ita, intellegō. Grātiās!", "en": "Yes, I understand. Thanks!" },
      { "sp": "Magister", "text": "Iūlia, lege, quaesō. Lentē!", "en": "Julia, read, please. Slowly!" },
      { "sp": "Iūlia", "text": "Nauta in īnsulā habitat…", "en": "A sailor lives on an island…" },
      { "sp": "Magister", "text": "Bene! Mārce, cūr nōn audīs? Mārcus dormit!", "en": "Good! Marcus, why aren't you listening? Marcus is asleep!" },
      { "sp": "Discipulī", "text": "Discipulī rīdent.", "en": "The students laugh." }
    ], "verified": false },
    { "id": "r05", "title": "Urbs Rōma", "level": "U8", "kind": "reading", "names": ["Rōma", "Tiberis", "Rōmae", "Rōmam", "Rōmulus", "Remus"], "lines": [
      { "text": "Rōma urbs magna et pulchra est. In urbe multī hominēs habitant.", "en": "Rome is a big and beautiful city. Many people live in the city." },
      { "text": "Tiberis flūmen Rōmae est; per urbem fluit.", "en": "The Tiber is Rome's river; it flows through the city." },
      { "text": "Prīmus rēx Rōmae Rōmulus erat. Rōmulus et Remus frātrēs erant.", "en": "The first king of Rome was Romulus. Romulus and Remus were brothers." },
      { "text": "In urbe cīvēs, mīlitēs, nautae, agricolae et poētae sunt.", "en": "In the city there are citizens, soldiers, sailors, farmers and poets." },
      { "text": "Nocte urbs dormit; lūx sōlis nōn est.", "en": "At night the city sleeps; there is no sunlight." },
      { "text": "Sed canēs in viīs currunt!", "en": "But dogs run in the streets!" },
      { "text": "Omnēs viae Rōmam dūcunt.", "en": "All roads lead to Rome." }
    ], "verified": false }
  ]
}
