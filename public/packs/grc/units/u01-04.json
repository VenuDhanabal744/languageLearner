  "grammar": [
    { "id": "eimi", "title": "εἰμί 'to be': εἰμί, εἶ, ἐστί…", "concept": "copula-zero", "body": [
      "**εἰμί** I am · **εἶ** you are · **ἐστί(ν)** he/she/it is · **ἐσμέν** we are · **ἐστέ** you (pl.) are · **εἰσί(ν)** they are. Compare Latin sum, es, est, sumus, estis, sunt: it's the same Indo-European verb.",
      "As in Latin, the pronoun is usually dropped: **μαθητής εἰμι** = I am a student. In short sentences Greek often leaves out ἐστί altogether: **σοφὸς ὁ ἀνήρ** '(is) wise, the man'. That's the zero copula you know from Arabic and Hebrew.",
      "Most present forms of εἰμί lean on the word before them and lose their accent (μαθητής εἰμι). The accent rules can wait; reading comes first."
    ], "examples": [
      { "text": "Μαθηταί ἐσμεν.", "en": "We are students." },
      { "text": "Νικίας καὶ Βένου φίλοι εἰσίν.", "en": "Nicias and Venu are friends." }
    ], "drills": [
      { "id": "ei1", "prompt": "Say: I am a student.", "answer": "Μαθητής εἰμι." },
      { "id": "ei2", "prompt": "Say: We are friends.", "answer": "Φίλοι ἐσμέν." },
      { "id": "ei3", "prompt": "Say: You are not a Greek (to one person).", "answer": "Οὐχ Ἕλλην εἶ." },
      { "id": "ei4", "prompt": "Say: They are students.", "answer": "Μαθηταί εἰσιν." }
    ], "verified": false },
    { "id": "questions", "title": "Questions (and the Greek question mark ;)", "body": [
      "Greek writes the question mark as **;** (it looks like our semicolon), and the raised dot **·** works like a colon or semicolon.",
      "A yes/no question can start with **ἆρα**, or just use your voice: **ἆρα Ἕλλην εἶ;** Question words: **τίς;** who? **τί;** what? why? **πῶς;** how? **ποῦ;** where? Answers: **ναί** yes, **οὔ / οὐχί** no."
    ], "examples": [
      { "text": "Πῶς ἔχεις; Εὖ ἔχω.", "en": "How are you? I'm well." },
      { "text": "Ποῦ ἐστιν ὁ φίλος;", "en": "Where is the friend?" }
    ], "drills": [
      { "id": "q1", "prompt": "Ask: Who are you?", "answer": "Τίς εἶ σύ;" },
      { "id": "q2", "prompt": "Ask: How are you?", "answer": "Πῶς ἔχεις;" },
      { "id": "q3", "prompt": "Ask: Are you a student?", "answer": "Ἆρα μαθητὴς εἶ;" },
      { "id": "q4", "prompt": "Say: Thank you, my friend.", "answer": "Χάριν ἔχω, ὦ φίλε." }
    ], "verified": false },
    { "id": "article", "title": "ὁ, ἡ, τό: Greek has 'the'", "concept": "definiteness", "body": [
      "Latin has no word for 'the'; Greek does, and uses it a lot, even with names (ὁ Νικίας) and abstract nouns (ἡ σοφία 'wisdom'). It changes for gender, number and case, so it is the best clue to a noun's case.",
      "Nominative: **ὁ** (m) · **ἡ** (f) · **τό** (n); plural **οἱ · αἱ · τά**. Every noun has a gender, shown by its article: **ὁ ποταμός**, **ἡ θάλαττα**, **τὸ δῶρον**, but also **ἡ νῆσος**, a feminine word in -ος."
    ], "examples": [
      { "text": "Ὁ ποταμὸς καὶ ἡ θάλαττα.", "en": "The river and the sea." },
      { "text": "Αἱ νῆσοι μικραί εἰσιν.", "en": "The islands are small." }
    ], "drills": [
      { "id": "ar1", "prompt": "Say: The river is big.", "answer": "Ὁ ποταμὸς μέγας ἐστίν." },
      { "id": "ar2", "prompt": "Say: The island is small.", "answer": "Ἡ νῆσος μικρά ἐστιν." },
      { "id": "ar3", "prompt": "Say: The islands are small.", "answer": "Αἱ νῆσοι μικραί εἰσιν." },
      { "id": "ar4", "prompt": "Say: Greece is a beautiful country.", "answer": "Ἡ Ἑλλὰς χώρα καλή ἐστιν." }
    ], "verified": false },
    { "id": "decl12", "title": "Nouns in -ος, -ον, -η, -α", "concept": "gender", "body": [
      "Second declension (Latin -us / -um): **ὁ ποταμός → οἱ ποταμοί**; **τὸ δῶρον → τὰ δῶρα**. First declension (Latin -a): **ἡ χώρα → αἱ χῶραι**; **ἡ τέχνη → αἱ τέχναι**.",
      "Greek -ος, -ον are Latin -us, -um before sound changes; Latin even borrowed Greek nouns this way (φιλόσοφος → philosophus). Plural -οι is Latin -ī; -αι is Latin -ae.",
      "Adjectives match their noun: **μέγας ποταμός**, **μεγάλη θάλαττα**, **καλὸν δῶρον**."
    ], "examples": [
      { "text": "Οἱ ποταμοὶ μεγάλοι εἰσίν.", "en": "The rivers are big." },
      { "text": "Αἱ χῶραι καλαί εἰσιν.", "en": "The lands are beautiful." }
    ], "drills": [
      { "id": "d12a", "prompt": "Say: The rivers are big.", "answer": "Οἱ ποταμοὶ μεγάλοι εἰσίν." },
      { "id": "d12b", "prompt": "Say: three small islands", "answer": "τρεῖς νῆσοι μικραί" },
      { "id": "d12c", "prompt": "Say: The Greek language is beautiful.", "answer": "Ἡ Ἑλληνικὴ γλῶττα καλή ἐστιν." },
