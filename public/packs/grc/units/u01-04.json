      { "id": "ac3", "prompt": "Say: I love my sister.", "answer": "Φιλῶ τὴν ἀδελφήν μου." },
      { "id": "ac4", "prompt": "Say: The dog is eating the bread.", "answer": "Ὁ κύων τὸν ἄρτον ἐσθίει." }
