    { "id": "r01", "title": "Ἡ Ἑλλάς", "level": "U2", "kind": "reading", "names": ["Ἰταλίᾳ", "Λατινική"], "lines": [
      { "text": "Ἡ Ἑλλὰς χώρα καλή ἐστιν, καὶ ἐν τῇ θαλάττῃ πολλαὶ νῆσοί εἰσιν.", "en": "Greece is a beautiful country, and in the sea there are many islands." },
      { "text": "Αἱ νῆσοι μικραί εἰσιν, ἡ δὲ θάλαττα μεγάλη.", "en": "The islands are small, but the sea is big." },
      { "text": "Ἀθῆναι ἐν τῇ Ἑλλάδι εἰσίν· ἐκεῖ πολλοὶ Ἕλληνές εἰσιν.", "en": "Athens is in Greece; there are many Greeks there." },
      { "text": "Ἡ δὲ Ῥώμη οὐκ ἐν τῇ Ἑλλάδι ἐστίν, ἀλλ᾽ ἐν τῇ Ἰταλίᾳ.", "en": "Rome is not in Greece but in Italy." },
      { "text": "Ἐν τῇ Ἑλλάδι ἡ Ἑλληνικὴ γλῶττα, ἐν δὲ τῇ Ἰταλίᾳ ἡ Λατινική.", "en": "In Greece (they speak) the Greek language, and in Italy Latin." },
      { "text": "Ἐγὼ δύο γλώττας μανθάνω· ἡ Ἑλληνικὴ καλή ἐστιν, καὶ ἡ Λατινικὴ καλή.", "en": "I'm learning two languages: Greek is beautiful, and Latin is beautiful too." }
    ], "verified": false },
    { "id": "r02", "title": "Ἡ οἰκία τοῦ Νικίου", "level": "U3", "kind": "reading", "names": ["Νικίου", "Νικίας"], "lines": [
      { "text": "Ἡ τοῦ Νικίου οἰκία ἐν Ἀθήναις ἐστίν.", "en": "Nicias' house is in Athens." },
      { "text": "Ὁ πατὴρ αὐτοῦ γέρων ἐστίν, ἡ δὲ μήτηρ καλή τε καὶ ἀγαθή.", "en": "His father is old, and his mother beautiful and good." },
      { "text": "Νικίας ἀδελφόν τε καὶ ἀδελφὴν ἔχει.", "en": "Nicias has a brother and a sister." },
      { "text": "Ὁ ἀδελφὸς πρεσβύτερός ἐστιν, ἡ δὲ ἀδελφὴ νεωτέρα.", "en": "The brother is older, and the sister younger." },
      { "text": "Ἐν τῇ οἰκίᾳ καὶ κύων ἐστίν· ὁ κύων φίλος ἐστὶ τῶν παίδων.", "en": "There is also a dog in the house; the dog is the children's friend." },
